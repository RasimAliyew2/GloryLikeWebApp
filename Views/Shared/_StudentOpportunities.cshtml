@using GloryLikeWebApp.Services
@model GloryLikeWebApp.Models.Student.StudentDashboardViewModel
@if (Model.Opportunities.Count == 0)
{
    <div class="student-empty"><span class="student-icon-tile"><partial name="_StudentIcon" model='"briefcase"' /></span><h3>@(Model.OpportunitiesAvailable ? "No internships yet" : "Opportunities are temporarily unavailable")</h3><p>@(Model.OpportunitiesAvailable ? "Internships will appear here when employers publish them. Add skills to see how you match each role." : "Refresh this page to try again.")</p><a href="/Student/Internships">Explore internships →</a></div>
}
else
{
    <div class="student-opportunities">
        @foreach (var role in (Model.Page == "Internships" ? Model.Opportunities : Model.Opportunities.Take(3)))
        {
            var title = string.IsNullOrWhiteSpace(role.RoleTitle) ? role.PositionName : role.RoleTitle;
            var link = role.HasApplied ? $"/Applications/{role.VacancyId}" : $"/Student/Internships?vacancyId={role.VacancyId}";
            <a class="student-opportunity" href="@link"><span class="student-opportunity-type"><partial name="_StudentIcon" model='"briefcase"' /> INTERNSHIP</span><h3>@title</h3><p>@role.EmployerName</p><small>@(string.IsNullOrWhiteSpace(role.LocationName) ? role.EmploymentType : role.LocationName + " · " + role.EmploymentType)</small><span class="student-opportunity-bottom"><span>@Math.Clamp(role.MatchScore, 0, 100)% match</span><strong>@(role.HasApplied ? "View application" : "View role") →</strong></span></a>
        }
    </div>
}
