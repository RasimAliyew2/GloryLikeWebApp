@model GloryLikeWebApp.Models.Employer.OrganizationReportsPageViewModel
@{
    Layout = "_EmployerReportsLayout";
    ViewData["Title"] = "Reports";
    ViewData["ReportsMainClass"] = "reports-index-main";
}

<section class="reports-index-page" aria-labelledby="reportsPageTitle">
    <header class="reports-page-heading">
        <div>
            <span class="reports-eyebrow">COMPANY REPORTING</span>
            <h1 id="reportsPageTitle">Reports</h1>
            <p>
                @(string.IsNullOrWhiteSpace(Model.CompanyName)
                    ? "Select a report to configure and execute."
                    : $"{Model.CompanyName} · select a report to configure and execute.")
            </p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="reports-alert" role="alert">@Model.ErrorMessage</div>
    }
    else
    {
        <div class="reports-link-list" aria-label="Available reports">
            @if (Model.Reports.Count == 0)
            {
                <p>No reports are available.</p>
            }
            else
            {
                @foreach (var report in Model.Reports)
                {
                    <article>
                        @if (report.Key == "vacancy-creation-by-employee")
                        {
                            <a asp-controller="EmployerReports"
                               asp-action="VacancyCreation">@report.Title</a>
                        }
                        else
                        {
                            <span>@report.Title</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(report.Description))
                        {
                            <p>@report.Description</p>
                        }
                    </article>
                }
            }
        </div>
    }
</section>
