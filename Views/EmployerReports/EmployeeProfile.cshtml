@model GloryLikeWebApp.Models.Employer.ReportEmployeeProfilePageViewModel
@{
    Layout = "_EmployerReportsLayout";
    ViewData["Title"] = Model.Employee?.DisplayName ?? "Employee profile";
}

<nav class="reports-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="EmployerReports" asp-action="Index">Reports</a>
    <span>›</span>
    <button type="button" onclick="history.back()">Back to generated report</button>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage) || Model.Employee is null)
{
    <div class="reports-alert" role="alert">
        @(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "Employee profile could not be loaded." : Model.ErrorMessage)
    </div>
}
else
{
    <section class="report-employee-profile">
        <header class="report-profile-cover">
            <div class="report-profile-avatar">
                @if (!string.IsNullOrWhiteSpace(Model.Employee.ProfileImageDataUrl))
                {
                    <img src="@Model.Employee.ProfileImageDataUrl" alt="@Model.Employee.DisplayName" />
                }
                else
                {
                    <span>@Model.Employee.Initials</span>
                }
            </div>
            <div>
                <span class="reports-eyebrow">COMPANY TEAM PROFILE</span>
                <h1>@Model.Employee.DisplayName</h1>
                <p>@Model.CompanyName</p>
            </div>
            <button type="button" class="report-back-button" onclick="history.back()">← Back</button>
        </header>

        <div class="report-profile-grid">
            <article>
                <span>Access role</span>
                <strong>@Model.Employee.Role</strong>
                <small>@Model.Employee.MembershipStatus</small>
            </article>
            <article>
                <span>Vacancies created</span>
                <strong>@Model.Employee.CreatedVacancyCount</strong>
                <small>All company history</small>
            </article>
            <article>
                <span>Email</span>
                <strong class="profile-email">@Model.Employee.Email</strong>
                <small>@(string.IsNullOrWhiteSpace(Model.Employee.UserName) ? "No username" : $"@{Model.Employee.UserName}")</small>
            </article>
            <article>
                <span>Date of birth</span>
                <strong>@(Model.Employee.BirthDate?.ToString("dd MMM yyyy") ?? "Not provided")</strong>
                <small>Profile information</small>
            </article>
        </div>

        <section class="report-profile-about">
            <span>About</span>
            <p>@(string.IsNullOrWhiteSpace(Model.Employee.About) ? "No about information has been added." : Model.Employee.About)</p>
        </section>
    </section>
}
