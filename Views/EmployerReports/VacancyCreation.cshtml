@using GloryLikeWebApp.Models.Employer
@model VacancyCreationReportPageViewModel
@{
    Layout = "_EmployerReportsLayout";
    ViewData["Title"] = Model.ReportTitle;

    var employeeLevel = Model.HierarchyLevels.First(level =>
        string.Equals(
            level.Scope,
            VacancyCreationReportPageViewModel.EmployeeScope,
            StringComparison.OrdinalIgnoreCase));
    var vacancyLevel = Model.HierarchyLevels.First(level =>
        string.Equals(
            level.Scope,
            VacancyCreationReportPageViewModel.VacancyScope,
            StringComparison.OrdinalIgnoreCase));
    var employeeColumns = employeeLevel.FieldKeys
        .Where(Model.Shows)
        .ToList();
    var vacancyColumns = vacancyLevel.FieldKeys
        .Where(Model.Shows)
        .ToList();
}

<nav class="reports-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="EmployerReports" asp-action="Index">Reports</a>
    <span>›</span>
    <strong>@Model.ReportTitle</strong>
</nav>

<section class="one-c-window report-designer">
    <header class="one-c-titlebar report-titlebar">
        <div>
            <span class="one-c-document-icon" aria-hidden="true">▤</span>
            <strong>@Model.ReportTitle</strong>
        </div>
        <span>@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "Company" : Model.CompanyName)</span>
    </header>

    <form method="get" action="/Employer/Reports/VacancyCreation" id="vacancyReportForm">
        <input type="hidden" name="Layout" id="reportHierarchyLayout" value="@Model.HierarchyLayout" />
        <input type="hidden" name="Fields" value="@VacancyCreationReportPageViewModel.EmployeeField" />

        <div class="one-c-commandbar">
            <button class="one-c-execute" type="submit" name="Execute" value="true">▶ Execute</button>
            <button class="one-c-command"
                    type="button"
                    id="reportSettingsToggle"
                    aria-controls="reportSettings"
                    aria-expanded="false">⚙ Settings</button>
            <a class="one-c-command" asp-controller="EmployerReports" asp-action="Index">← Report list</a>
        </div>

        <div class="report-parameters">
            <strong>Parameters</strong>
            <label>
                <span>Period from</span>
                <input type="date" name="DateFrom" value="@Model.DateFrom.ToString("yyyy-MM-dd")" required />
            </label>
            <label>
                <span>to</span>
                <input type="date" name="DateTo" value="@Model.DateTo.ToString("yyyy-MM-dd")" required />
            </label>
        </div>

        <section class="report-settings" id="reportSettings" hidden>
            <header>
                <strong>Report settings</strong>
                <span>Drag fields to reorder them or move them between hierarchy levels.</span>
            </header>

            <div class="report-hierarchy" id="reportHierarchy" role="tree" aria-label="Report hierarchy">
                <div class="report-hierarchy-root" role="treeitem" aria-expanded="true">
                    <span aria-hidden="true">⊟</span>
                    <strong>Report</strong>
                </div>

                @for (var levelIndex = 0; levelIndex < Model.HierarchyLevels.Count; levelIndex++)
                {
                    var level = Model.HierarchyLevels[levelIndex];
                    <div class="report-hierarchy-level" role="group" data-hierarchy-level data-scope="@level.Scope">
                        <div class="report-hierarchy-level-label">
                            <span aria-hidden="true">@(levelIndex == Model.HierarchyLevels.Count - 1 ? "└" : "├")</span>
                            <strong>Level @(levelIndex + 1)</strong>
                        </div>
                        <div class="report-hierarchy-fields" data-hierarchy-field-list data-scope="@level.Scope">
                            @foreach (var field in level.FieldKeys)
                            {
                                var isEmployeeField = string.Equals(
                                    field,
                                    VacancyCreationReportPageViewModel.EmployeeField,
                                    StringComparison.OrdinalIgnoreCase);
                                <article class="report-hierarchy-field"
                                         draggable="true"
                                         data-hierarchy-field
                                         data-field-key="@field"
                                         data-fixed-scope="@(isEmployeeField ? VacancyCreationReportPageViewModel.EmployeeScope : string.Empty)">
                                    <span class="report-field-drag" aria-hidden="true">⠿</span>
                                    <label>
                                        <input type="checkbox"
                                               name="@(isEmployeeField ? null : "Fields")"
                                               value="@field"
                                               checked="@Model.Shows(field)"
                                               disabled="@isEmployeeField" />
                                        <span>@Model.LabelFor(field)</span>
                                    </label>
                                    <small>@Model.TypeFor(field)</small>
                                    <div class="report-field-actions">
                                        <button type="button" data-hierarchy-action="left" title="Move left" aria-label="Move @Model.LabelFor(field) left">←</button>
                                        <button type="button" data-hierarchy-action="right" title="Move right" aria-label="Move @Model.LabelFor(field) right">→</button>
                                        <button type="button" data-hierarchy-action="up" title="Move to upper level" aria-label="Move @Model.LabelFor(field) to upper level" disabled="@(levelIndex == 0 || isEmployeeField)">↑</button>
                                        <button type="button" data-hierarchy-action="down" title="Move to lower level" aria-label="Move @Model.LabelFor(field) to lower level" disabled="@(levelIndex == Model.HierarchyLevels.Count - 1 || isEmployeeField)">↓</button>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="reports-alert report-inline-alert" role="alert">@Model.ErrorMessage</div>
    }
    else if (!Model.WasExecuted)
    {
        <div class="report-ready-state">
            <span aria-hidden="true">▤</span>
            <strong>Configure the report and click Execute</strong>
            <p>The current month is selected by default. All values are loaded from SQL.</p>
        </div>
    }
    else
    {
        <section class="report-result" aria-labelledby="reportResultTitle">
            <header>
                <div>
                    <h1 id="reportResultTitle">@Model.ReportTitle</h1>
                    <p>@Model.CompanyName</p>
                </div>
                <dl>
                    <div><dt>Period</dt><dd>@Model.DateFrom.ToString("dd.MM.yyyy") — @Model.DateTo.ToString("dd.MM.yyyy")</dd></div>
                    <div><dt>Generated</dt><dd>@Model.GeneratedAtUtc?.ToString("dd.MM.yyyy HH:mm") UTC</dd></div>
                </dl>
            </header>

            <div class="report-result-hint">
                <span>ℹ</span>
                Double-click a blue employee value to open its profile. Vacancies open in a new tab.
            </div>

            <div class="report-table-wrap">
                <table class="one-c-report-table report-level-table report-employee-table">
                    <thead>
                        <tr>
                            @foreach (var field in employeeColumns)
                            {
                                <th class="@(field == VacancyCreationReportPageViewModel.VacancyCountField ? "numeric-column" : string.Empty)">@Model.LabelFor(field)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model.Employees)
                        {
                            var childClass = $"employee-vacancies-{employee.UserId}";
                            <tr class="report-employee-row">
                                @for (var columnIndex = 0; columnIndex < employeeColumns.Count; columnIndex++)
                                {
                                    var field = employeeColumns[columnIndex];
                                    <td class="@(field == VacancyCreationReportPageViewModel.VacancyCountField ? "numeric-cell" : string.Empty)">
                                        <div class="report-value-cell">
                                            @if (columnIndex == 0)
                                            {
                                                @if (vacancyColumns.Count > 0 && employee.Vacancies.Count > 0)
                                                {
                                                    <button class="report-row-toggle" type="button" data-report-group="@childClass" aria-expanded="true" aria-label="Collapse @employee.DisplayName vacancies">−</button>
                                                }
                                                else
                                                {
                                                    <span class="report-row-spacer"></span>
                                                }
                                            }

                                            @if (field == VacancyCreationReportPageViewModel.EmployeeField)
                                            {
                                                <span class="report-row-icon" aria-hidden="true">♙</span>
                                                <span class="report-custom-value"
                                                      tabindex="0"
                                                      data-report-type="user"
                                                      data-report-href="@Url.Action("EmployeeProfile", "EmployerReports", new { employeeUserId = employee.UserId })"
                                                      title="Double-click to open employee profile">@employee.DisplayName</span>
                                            }
                                            else if (field == VacancyCreationReportPageViewModel.VacanciesField)
                                            {
                                                <span class="report-value-list">
                                                    @foreach (var vacancy in employee.Vacancies)
                                                    {
                                                        <span class="report-custom-value"
                                                              tabindex="0"
                                                              data-report-type="vacancy"
                                                              data-report-target="_blank"
                                                              data-report-href="@Url.Action("Detail", "EmployerVacancies", new { vacancyId = vacancy.VacancyId })"
                                                              title="Double-click to open vacancy in a new tab">@vacancy.Title</span>
                                                    }
                                                    @if (employee.Vacancies.Count == 0)
                                                    {
                                                        <span>—</span>
                                                    }
                                                </span>
                                            }
                                            else
                                            {
                                                <span>@Model.EmployeeValue(field, employee)</span>
                                                @if (field == VacancyCreationReportPageViewModel.EmployeeRoleField
                                                     && !string.Equals(employee.MembershipStatus, "Active", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <small class="former-member">@employee.MembershipStatus</small>
                                                }
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>

                            @if (vacancyColumns.Count > 0 && employee.Vacancies.Count > 0)
                            {
                                <tr class="report-vacancy-band @childClass" data-report-group-row="@childClass">
                                    <td colspan="@employeeColumns.Count">
                                        <table class="one-c-report-table report-level-table report-vacancy-table">
                                            <thead>
                                                <tr>
                                                    @foreach (var field in vacancyColumns)
                                                    {
                                                        <th class="@(field == VacancyCreationReportPageViewModel.VacancyCountField ? "numeric-column" : string.Empty)">@Model.LabelFor(field)</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var vacancy in employee.Vacancies)
                                                {
                                                    <tr class="report-vacancy-row">
                                                        @foreach (var field in vacancyColumns)
                                                        {
                                                            <td class="@(field == VacancyCreationReportPageViewModel.VacancyCountField ? "numeric-cell" : string.Empty)">
                                                                @if (field == VacancyCreationReportPageViewModel.EmployeeField)
                                                                {
                                                                    <span class="report-custom-value"
                                                                          tabindex="0"
                                                                          data-report-type="user"
                                                                          data-report-href="@Url.Action("EmployeeProfile", "EmployerReports", new { employeeUserId = employee.UserId })"
                                                                          title="Double-click to open employee profile">@employee.DisplayName</span>
                                                                }
                                                                else if (field == VacancyCreationReportPageViewModel.VacanciesField)
                                                                {
                                                                    <span class="report-row-icon" aria-hidden="true">▤</span>
                                                                    <span class="report-custom-value"
                                                                          tabindex="0"
                                                                          data-report-type="vacancy"
                                                                          data-report-target="_blank"
                                                                          data-report-href="@Url.Action("Detail", "EmployerVacancies", new { vacancyId = vacancy.VacancyId })"
                                                                          title="Double-click to open vacancy in a new tab">@vacancy.Title</span>
                                                                    @if (!string.IsNullOrWhiteSpace(vacancy.PlatformVacancyId))
                                                                    {
                                                                        <small class="report-platform-id">@vacancy.PlatformVacancyId</small>
                                                                    }
                                                                }
                                                                else if (field == VacancyCreationReportPageViewModel.VacancyStatusField)
                                                                {
                                                                    <span class="report-status">@vacancy.Status</span>
                                                                }
                                                                else
                                                                {
                                                                    @Model.VacancyValue(field, employee, vacancy)
                                                                }
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            @for (var columnIndex = 0; columnIndex < employeeColumns.Count; columnIndex++)
                            {
                                var field = employeeColumns[columnIndex];
                                if (field == VacancyCreationReportPageViewModel.VacancyCountField)
                                {
                                    <th class="numeric-cell">@Model.TotalVacancyCount</th>
                                }
                                else if (columnIndex == 0)
                                {
                                    <th>Total</th>
                                }
                                else
                                {
                                    <td></td>
                                }
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>
    }

    <footer class="one-c-statusbar">
        <span>@(Model.WasExecuted ? $"{Model.Employees.Count} employee row(s)" : "Ready")</span>
        <span>SQL reporting mode</span>
    </footer>
</section>

@section Scripts {
    <script src="~/js/employer-reports.js" asp-append-version="true"></script>
}
