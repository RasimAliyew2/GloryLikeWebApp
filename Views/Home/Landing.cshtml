@{
    Layout = null;
    ViewData["Title"] = "BothFind — Skills meet opportunity";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BothFind is a skills-first recruitment platform that helps candidates find relevant opportunities and employers discover better-matched talent." />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="BothFind — Skills meet opportunity" />
    <meta property="og:description" content="Build a trusted skills profile, discover relevant jobs and hire with clearer evidence." />
    <meta property="og:url" content="https://bothfind.com/" />
    <meta property="og:site_name" content="BothFind" />
    <link rel="canonical" href="https://bothfind.com/" />
    <title>BothFind — Skills meet opportunity</title>
    <link rel="stylesheet" href="~/css/public-site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="public-header">
        <div class="public-container header-row">
            <a class="public-brand" href="/" aria-label="BothFind home">
                <span class="brand-symbol" aria-hidden="true">
                    <span></span><span></span>
                </span>
                <span>BothFind</span>
            </a>

            <nav class="desktop-nav" aria-label="Main navigation">
                <a href="#how-it-works">How it works</a>
                <a href="#candidates">For candidates</a>
                <a href="#employers">For employers</a>
                <a href="https://bothfind.com/privacy">Privacy</a>
            </nav>

            <div class="header-actions">
                <a class="text-button" href="/SignIn">Sign in</a>
                <a class="primary-button compact" href="/Registration">Create account</a>
            </div>
        </div>
    </header>

    <main id="main-content">
        <section class="hero-section">
            <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
            <div class="hero-glow hero-glow-two" aria-hidden="true"></div>
            <div class="public-container hero-grid">
                <div class="hero-copy">
                    <div class="announcement-pill">
                        <span class="announcement-dot" aria-hidden="true"></span>
                        Skills-first hiring, built for better matches
                    </div>
                    <h1>Where the right skills meet the right opportunity.</h1>
                    <p class="hero-lead">
                        BothFind connects candidates and employers through verified skills,
                        clear role requirements and meaningful match insights—not just keywords.
                    </p>
                    <div class="hero-actions">
                        <a class="primary-button" href="/Registration?accountType=candidate">
                            Build your profile
                            <span aria-hidden="true">→</span>
                        </a>
                        <a class="secondary-button" href="/Registration?accountType=employer">
                            Start hiring
                        </a>
                    </div>
                    <div class="trust-row" aria-label="BothFind platform highlights">
                        <span><i aria-hidden="true">✓</i> Candidate profiles</span>
                        <span><i aria-hidden="true">✓</i> Vacancy matching</span>
                        <span><i aria-hidden="true">✓</i> Secure sign-in</span>
                    </div>
                </div>

                <div class="product-visual" aria-label="Preview of BothFind matching experience">
                    <div class="visual-topbar">
                        <div class="visual-brand">
                            <span class="brand-symbol small" aria-hidden="true"><span></span><span></span></span>
                            BothFind
                        </div>
                        <div class="visual-avatar">AR</div>
                    </div>
                    <div class="visual-content">
                        <div class="match-heading">
                            <div>
                                <span class="visual-kicker">TOP OPPORTUNITY</span>
                                <h2>Senior Product Analyst</h2>
                                <p>Technology · Hybrid</p>
                            </div>
                            <div class="match-score">
                                <strong>92</strong>
                                <span>match</span>
                            </div>
                        </div>
                        <div class="skill-match-list">
                            <div class="skill-match-row">
                                <div><span>Data analysis</span><strong>96%</strong></div>
                                <div class="meter"><i style="width:96%"></i></div>
                            </div>
                            <div class="skill-match-row">
                                <div><span>Product strategy</span><strong>89%</strong></div>
                                <div class="meter"><i style="width:89%"></i></div>
                            </div>
                            <div class="skill-match-row">
                                <div><span>Stakeholder management</span><strong>86%</strong></div>
                                <div class="meter"><i style="width:86%"></i></div>
                            </div>
                        </div>
                        <div class="visual-footer">
                            <div class="candidate-stack" aria-hidden="true">
                                <span>MS</span><span>JN</span><span>+8</span>
                            </div>
                            <p><strong>10 candidates</strong> match this role</p>
                            <span class="visual-action">View match →</span>
                        </div>
                    </div>
                    <div class="floating-card verified-card">
                        <span class="floating-icon">✓</span>
                        <div><strong>Skill verified</strong><small>Evidence added</small></div>
                    </div>
                    <div class="floating-card insight-card">
                        <span class="floating-icon spark">✦</span>
                        <div><strong>Better fit</strong><small>Skills aligned</small></div>
                    </div>
                </div>
            </div>
        </section>

        <section class="proof-strip" aria-label="Platform value">
            <div class="public-container proof-grid">
                <div><strong>Skills-first</strong><span>Profiles built around capability</span></div>
                <div><strong>Clearer matches</strong><span>Relevant roles and candidates</span></div>
                <div><strong>One platform</strong><span>From discovery to application</span></div>
                <div><strong>User control</strong><span>Transparent privacy choices</span></div>
            </div>
        </section>

        <section class="section-block" id="how-it-works">
            <div class="public-container">
                <div class="section-heading centered">
                    <span class="section-label">HOW BOTHFIND WORKS</span>
                    <h2>A clearer path from potential to progress.</h2>
                    <p>Both sides see the information that matters, at the moment it matters.</p>
                </div>
                <div class="steps-grid">
                    <article class="step-card">
                        <span class="step-number">01</span>
                        <div class="step-icon profile-icon" aria-hidden="true">◎</div>
                        <h3>Build a skills profile</h3>
                        <p>Candidates add experience, skills and evidence that show more than a traditional CV.</p>
                    </article>
                    <article class="step-card featured">
                        <span class="step-number">02</span>
                        <div class="step-icon" aria-hidden="true">✦</div>
                        <h3>Understand the match</h3>
                        <p>BothFind compares role needs with candidate strengths to surface meaningful alignment.</p>
                    </article>
                    <article class="step-card">
                        <span class="step-number">03</span>
                        <div class="step-icon" aria-hidden="true">↗</div>
                        <h3>Move forward confidently</h3>
                        <p>Apply to relevant roles or review qualified candidates through a focused hiring workflow.</p>
                    </article>
                </div>
            </div>
        </section>

        <section class="audience-section" id="candidates">
            <div class="public-container audience-grid">
                <div class="audience-panel candidate-panel">
                    <span class="section-label light">FOR CANDIDATES</span>
                    <h2>Let your real capability lead the conversation.</h2>
                    <p>Create a professional profile, keep your skills organised and find vacancies aligned with your experience.</p>
                    <ul class="feature-list">
                        <li><span>✓</span> Build and manage your skills profile</li>
                        <li><span>✓</span> Discover relevant live vacancies</li>
                        <li><span>✓</span> Track applications in one place</li>
                    </ul>
                    <a class="panel-link light" href="/Registration?accountType=candidate">Create candidate profile <span>→</span></a>
                </div>
                <div class="audience-panel employer-panel" id="employers">
                    <span class="section-label">FOR EMPLOYERS</span>
                    <h2>Hire with more context and less guesswork.</h2>
                    <p>Publish clear roles, collaborate with your hiring team and identify candidates whose skills fit the work.</p>
                    <ul class="feature-list dark">
                        <li><span>✓</span> Define structured skill requirements</li>
                        <li><span>✓</span> Review applicants and match insights</li>
                        <li><span>✓</span> Organise your recruitment workflow</li>
                    </ul>
                    <a class="panel-link" href="/Registration?accountType=employer">Create employer account <span>→</span></a>
                </div>
            </div>
        </section>

        <section class="privacy-section">
            <div class="public-container privacy-callout">
                <div class="privacy-icon" aria-hidden="true">
                    <span>✓</span>
                </div>
                <div class="privacy-copy">
                    <span class="section-label">PRIVACY BY DESIGN</span>
                    <h2>Your information should work for you.</h2>
                    <p>
                        BothFind explains what data is collected, how it is used and the choices available to you.
                        Google sign-in is used only to authenticate you and create or locate your BothFind account.
                    </p>
                </div>
                <a class="privacy-link" href="https://bothfind.com/privacy">
                    Read our Privacy Policy
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>

        <section class="cta-section">
            <div class="public-container cta-card">
                <div>
                    <span class="section-label light">GET STARTED</span>
                    <h2>Find the next right move.</h2>
                    <p>Join BothFind as a candidate or employer and turn better information into better decisions.</p>
                </div>
                <div class="cta-actions">
                    <a class="white-button" href="/Registration">Create an account</a>
                    <a class="ghost-button" href="/SignIn">Sign in</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="public-footer">
        <div class="public-container footer-main">
            <div class="footer-intro">
                <a class="public-brand footer-brand" href="/" aria-label="BothFind home">
                    <span class="brand-symbol" aria-hidden="true"><span></span><span></span></span>
                    <span>BothFind</span>
                </a>
                <p>Connecting people, skills and opportunities through clearer, more meaningful matches.</p>
            </div>
            <div class="footer-column">
                <strong>Platform</strong>
                <a href="#candidates">For candidates</a>
                <a href="#employers">For employers</a>
                <a href="/SignIn">Sign in</a>
            </div>
            <div class="footer-column">
                <strong>Legal</strong>
                <a href="https://bothfind.com/privacy">Privacy Policy</a>
                <a href="https://bothfind.com/terms">Terms of Service</a>
            </div>
            <div class="footer-column">
                <strong>Contact</strong>
                <a href="mailto:support@bothfind.com">support@bothfind.com</a>
                <a href="mailto:privacy@bothfind.com">privacy@bothfind.com</a>
            </div>
        </div>
        <div class="public-container footer-bottom">
            <span>&copy; 2026 BothFind. All rights reserved.</span>
            <span>Built for better work connections.</span>
        </div>
    </footer>
</body>
</html>
