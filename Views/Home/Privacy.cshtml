@{
    Layout = null;
    ViewData["Title"] = "Privacy Policy";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Learn how BothFind collects, uses, stores and protects personal information." />
    <title>Privacy Policy | BothFind</title>
    <link rel="stylesheet" href="~/css/privacy.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="/" aria-label="BothFind home">
                <span class="brand-mark" aria-hidden="true">B</span>
                <span>BothFind</span>
            </a>

            <nav class="header-nav" aria-label="Account navigation">
                <a href="/SignIn">Sign in</a>
                <a class="header-button" href="/Registration">Create an account</a>
            </nav>
        </div>
    </header>

    <main>
        <section class="policy-hero">
            <div class="hero-inner">
                <p class="eyebrow">YOUR DATA, CLEARLY EXPLAINED</p>
                <h1>Privacy Policy</h1>
                <p class="hero-copy">
                    This policy explains what information BothFind collects, why we use it,
                    when it may be shared and the choices available to you.
                </p>
                <p class="effective-date">Effective date: August 9, 2026</p>
            </div>
        </section>

        <div class="policy-layout">
            <aside class="policy-nav" aria-label="Privacy policy contents">
                <p>On this page</p>
                <a href="#scope">1. Scope</a>
                <a href="#information">2. Information we collect</a>
                <a href="#use">3. How we use information</a>
                <a href="#social-sign-in">4. Google and Apple sign-in</a>
                <a href="#sharing">5. When information is shared</a>
                <a href="#retention">6. Retention and security</a>
                <a href="#choices">7. Your choices and rights</a>
                <a href="#cookies">8. Cookies</a>
                <a href="#international">9. International transfers</a>
                <a href="#children">10. Younger users</a>
                <a href="#changes">11. Changes to this policy</a>
                <a href="#contact">12. Contact us</a>
            </aside>

            <article class="policy-content">
                <section id="scope">
                    <span class="section-number">01</span>
                    <h2>Scope and who we are</h2>
                    <p>
                        BothFind is a recruitment and professional profile platform that helps candidates
                        discover opportunities and helps employers publish vacancies, manage company profiles
                        and review applicants. This policy applies to the BothFind website, accounts and related
                        services that link to this page.
                    </p>
                    <p>
                        For the personal information described here, BothFind is the organisation responsible
                        for deciding how and why that information is processed, unless a different party is
                        identified at the time of collection.
                    </p>
                </section>

                <section id="information">
                    <span class="section-number">02</span>
                    <h2>Information we collect</h2>
                    <p>We collect information in the following categories:</p>
                    <ul>
                        <li>
                            <strong>Account information:</strong> name, surname, username, email address,
                            phone number, account type and authentication information.
                        </li>
                        <li>
                            <strong>Candidate profile information:</strong> skills, work experience,
                            professional interests, profile details, applications and other information you
                            choose to add.
                        </li>
                        <li>
                            <strong>Employer information:</strong> company name, industry, company profile,
                            team membership, vacancies and recruitment activity.
                        </li>
                        <li>
                            <strong>Social sign-in information:</strong> verified email address, first name,
                            surname and a provider-specific account identifier received from Google or Apple.
                        </li>
                        <li>
                            <strong>Technical and usage information:</strong> IP address, browser and device
                            information, sign-in events, pages viewed, security logs and cookie identifiers.
                        </li>
                        <li>
                            <strong>Communications:</strong> information you provide when you contact us or
                            submit a privacy request.
                        </li>
                    </ul>
                    <p>
                        We receive most information directly from you. We may also receive information from
                        an employer or team administrator who invites you, from Google or Apple when you choose
                        social sign-in, and automatically from your browser when you use the service.
                    </p>
                </section>

                <section id="use">
                    <span class="section-number">03</span>
                    <h2>How we use information</h2>
                    <p>We use personal information to:</p>
                    <ul>
                        <li>create, authenticate and maintain your account;</li>
                        <li>provide candidate, employer and company-team features;</li>
                        <li>display profiles, vacancies and applications to the appropriate users;</li>
                        <li>generate job recommendations, matching indicators and platform reports;</li>
                        <li>send service, verification, security and account-related messages;</li>
                        <li>prevent fraud, misuse and unauthorised access;</li>
                        <li>diagnose errors, maintain performance and improve the service; and</li>
                        <li>meet legal obligations and enforce our terms.</li>
                    </ul>
                    <p>
                        Depending on your location and the activity involved, we process information because
                        it is needed to provide the service you requested, because you gave consent, because
                        we have a legitimate interest in operating and securing BothFind, or because the law
                        requires it. You may withdraw consent for future processing where consent is the basis.
                    </p>
                    <div class="notice-card">
                        <h3>Automated recommendations</h3>
                        <p>
                            BothFind may use automated tools to suggest vacancies, candidates or matching
                            indicators. These tools support discovery and recruitment workflows; employers
                            remain responsible for their own hiring decisions.
                        </p>
                    </div>
                </section>

                <section id="social-sign-in">
                    <span class="section-number">04</span>
                    <h2>Google and Apple sign-in</h2>
                    <p>
                        If you choose “Sign in with Google” or “Sign in with Apple,” the provider authenticates
                        you and sends BothFind the information needed to create or locate your account. We request
                        only basic identity information: your verified email address, name and provider account
                        identifier. Apple may provide your name only the first time you authorise BothFind.
                    </p>
                    <p>
                        We use this information only for authentication, account creation, account security and
                        the operation of the features described in this policy. We do not use social sign-in data
                        for targeted advertising, sell it, or allow people to access your Google or Apple password.
                    </p>
                    <p>
                        Our use of information received from Google APIs follows the
                        <a href="https://developers.google.com/terms/api-services-user-data-policy"
                           target="_blank"
                           rel="noopener noreferrer">Google API Services User Data Policy</a>,
                        including its Limited Use requirements. You can manage third-party access in your
                        <a href="https://myaccount.google.com/connections"
                           target="_blank"
                           rel="noopener noreferrer">Google Account</a> or
                        <a href="https://appleid.apple.com/"
                           target="_blank"
                           rel="noopener noreferrer">Apple Account</a> settings.
                    </p>
                    <p>
                        Removing BothFind from your Google or Apple account stops future provider access, but it
                        does not automatically delete information already stored in your BothFind account. You can
                        request deletion as described below.
                    </p>
                </section>

                <section id="sharing">
                    <span class="section-number">05</span>
                    <h2>When information is shared</h2>
                    <p>We do not sell your personal information. We may share it only as needed with:</p>
                    <ul>
                        <li>
                            <strong>Candidates, employers and authorised company-team members</strong> when
                            platform features, profile visibility or an application require that access.
                        </li>
                        <li>
                            <strong>Service providers</strong> that support hosting, email delivery, security,
                            analytics and technical operations under appropriate confidentiality obligations.
                        </li>
                        <li>
                            <strong>Authorities or other parties</strong> when required by law, legal process,
                            safety needs, fraud prevention or the protection of legal rights.
                        </li>
                        <li>
                            <strong>A successor organisation</strong> if BothFind is involved in a merger,
                            acquisition, financing or transfer of assets, subject to applicable safeguards.
                        </li>
                    </ul>
                    <p>
                        Employers and candidates may separately control information they receive through the
                        platform. Their own privacy obligations may apply to how they use that information.
                    </p>
                </section>

                <section id="retention">
                    <span class="section-number">06</span>
                    <h2>Retention and security</h2>
                    <p>
                        We keep personal information while your account is active and for as long as reasonably
                        necessary to provide the service, resolve disputes, maintain security, prevent abuse and
                        meet legal obligations. Retention periods depend on the type of record and why it is held.
                        When information is no longer required, we delete it, anonymise it or isolate it from
                        ordinary use until deletion is possible from backups.
                    </p>
                    <p>
                        We use reasonable technical and organisational safeguards designed to protect personal
                        information from loss, misuse and unauthorised access, alteration or disclosure. No online
                        service can guarantee absolute security, so you should use a strong password and protect
                        access to your email and devices.
                    </p>
                </section>

                <section id="choices">
                    <span class="section-number">07</span>
                    <h2>Your choices and rights</h2>
                    <p>
                        Depending on your location, you may have the right to request access to, correction of,
                        deletion of, restriction of or a portable copy of your personal information. You may also
                        object to certain processing, withdraw consent and complain to your local data-protection
                        authority.
                    </p>
                    <p>
                        You can update certain profile information inside your account. For other requests,
                        including account or Google/Apple sign-in data deletion, email
                        <a href="mailto:privacy@bothfind.com">privacy@bothfind.com</a>. We may ask you to verify
                        your identity before completing a request. Some information may be retained where the law
                        permits or requires it, including for security, fraud prevention or legal claims.
                    </p>
                </section>

                <section id="cookies">
                    <span class="section-number">08</span>
                    <h2>Cookies and similar technologies</h2>
                    <p>
                        BothFind uses cookies and similar technologies that are necessary to keep you signed in,
                        remember security choices, protect forms and maintain the service. We may also use limited
                        measurement information to understand performance and improve features. Browser settings
                        can block or remove cookies, but essential account features may then stop working.
                    </p>
                </section>

                <section id="international">
                    <span class="section-number">09</span>
                    <h2>International data transfers</h2>
                    <p>
                        BothFind and its service providers may process information in countries other than the
                        country where you live. Where applicable law requires it, we use recognised safeguards for
                        international transfers and require service providers to protect the information they handle.
                    </p>
                </section>

                <section id="children">
                    <span class="section-number">10</span>
                    <h2>Younger users</h2>
                    <p>
                        BothFind is intended for people who meet the minimum age required to use employment and
                        online account services in their country. If local law requires parental or guardian
                        permission, you may use BothFind only with that permission. If you believe a child provided
                        personal information without the permission required by law, contact us so we can review and
                        take appropriate action.
                    </p>
                </section>

                <section id="changes">
                    <span class="section-number">11</span>
                    <h2>Changes to this policy</h2>
                    <p>
                        We may update this policy when our services, data practices or legal obligations change.
                        We will publish the updated policy here and change the effective date. If a change is
                        material, we may also provide a notice through the service or by email where appropriate.
                    </p>
                </section>

                <section id="contact" class="contact-section">
                    <span class="section-number">12</span>
                    <h2>Contact us</h2>
                    <p>
                        Questions, privacy requests and account-deletion requests can be sent to:
                    </p>
                    <a class="contact-link" href="mailto:privacy@bothfind.com">privacy@bothfind.com</a>
                    <p class="contact-note">
                        Include the email address connected to your BothFind account. Do not send your password
                        or social-provider secret.
                    </p>
                </section>
            </article>
        </div>
    </main>

    <footer class="site-footer">
        <div>
            <a class="brand footer-brand" href="/">
                <span class="brand-mark" aria-hidden="true">B</span>
                <span>BothFind</span>
            </a>
            <p>Connecting people, skills and opportunities.</p>
        </div>
        <div class="footer-links">
            <a href="/privacy" aria-current="page">Privacy Policy</a>
            <a href="/SignIn">Sign in</a>
            <a href="/Registration">Create an account</a>
        </div>
        <p class="copyright">&copy; 2026 BothFind. All rights reserved.</p>
    </footer>
</body>
</html>
