@model GloryLikeWebApp.Models.Employer.EmployerVacancyDetailPageViewModel
@{
    Layout = null;
    ViewData["Title"] = Model.Vacancy?.Title ?? "Vacancy detail";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SkillMatch</title>

    <link
        rel="stylesheet"
        href="~/css/employer-home.css"
        asp-append-version="true" />
    <link
        rel="stylesheet"
        href="~/css/employer-vacancy-detail.css"
        asp-append-version="true" />
</head>

<body>
    <div class="employer-shell vacancy-detail-shell">
        <header class="employer-topbar">
            <a
                class="employer-brand"
                href="/Portal/Home">
                SkillMatch
            </a>

            <div class="employer-search">
                <span>⌕</span>
                <input
                    type="search"
                    placeholder="Search by candidates/vacancies"
                    aria-label="Search candidates or vacancies" />
            </div>

            <a class="employer-account" href="/Profile" aria-label="Open profile">
                <span class="demo-badge">Employer</span>

                <div class="employer-avatar">
                    @Model.Initials
                </div>

                <div class="employer-account-copy">
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Email)
                            ? Model.DisplayName
                            : Model.Email)
                    </strong>
                    <span>Employer workspace</span>
                </div>

            </a>
        </header>

        <aside
            class="employer-sidebar"
            id="employerSidebar">
            <nav aria-label="Employer navigation">
                <a
                    asp-controller="EmployerHome"
                    asp-action="EmployerHome">
                    <span>⌁</span>
                    <strong>Dashboard</strong>
                </a>

                <a
                    class="active"
                    asp-controller="EmployerVacancies"
                    asp-action="Index">
                    <span>▣</span>
                    <strong>Vacancies</strong>
                </a>

                <a href="#">
                    <span>▱</span>
                    <strong>Recruitment requests</strong>
                </a>

                <a
                    asp-controller="TalentRadar"
                    asp-action="Index">
                    <span>◎</span>
                    <strong>Talent Radar</strong>
                </a>

                <a
                    asp-controller="EmployerCompany"
                    asp-action="Index">
                    <span>▥</span>
                    <strong>Company</strong>
                </a>

                <a
                    asp-controller="EmployerReports"
                    asp-action="Index">
                    <span>▧</span>
                    <strong>Reports</strong>
                </a>
            </nav>

            <div class="employer-sidebar-bottom">
                <form method="post" action="/SignOut">
                    @Html.AntiForgeryToken()
                    <button type="submit">↪ Sign out</button>
                </form>
            </div>
        </aside>

        <main class="employer-main vacancy-detail-main">
            <button
                class="employer-menu-button"
                type="button"
                id="employerMenuButton"
                aria-label="Open employer menu">
                ☰
            </button>

            @if (Model.Vacancy is not { } vacancy)
            {
                <section class="vacancy-detail-error">
                    <span>!</span>
                    <h1>Vacancy could not be opened</h1>
                    <p>
                        @(string.IsNullOrWhiteSpace(Model.ErrorMessage)
                            ? "Vacancy tapılmadı və ya bu employer-ə aid deyil."
                            : Model.ErrorMessage)
                    </p>
                    <a
                        asp-controller="EmployerVacancies"
                        asp-action="Index">
                        ← Back to vacancies
                    </a>
                </section>
            }
            else
            {
                <nav class="vacancy-detail-breadcrumb" aria-label="Breadcrumb">
                    <a
                        asp-controller="EmployerVacancies"
                        asp-action="Index">
                        Vacancies
                    </a>
                    <span>›</span>
                    <strong>@vacancy.Title</strong>
                </nav>

                <section class="vacancy-detail-heading">
                    <div class="vacancy-detail-title-copy">
                        <span class="vacancy-detail-id">
                            @vacancy.PlatformVacancyId
                        </span>
                        <h1>@vacancy.Title</h1>
                        <p>
                            @vacancy.JobFamilyName
                            @if (!string.IsNullOrWhiteSpace(vacancy.SeniorityName))
                            {
                                <span> · @vacancy.SeniorityName</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(vacancy.EmploymentType))
                            {
                                <span> · @vacancy.EmploymentType</span>
                            }
                        </p>
                        <small>
                            ✦ Hiring decisions use the vacancy skill template and
                            candidates' saved SQL skill signals.
                        </small>
                    </div>

                    <div class="vacancy-detail-actions">
                        <span
                            class="vacancy-detail-status @vacancy.StatusCssClass"
                            id="vacancyStatusBadge">
                            @vacancy.StatusLabel
                        </span>

                        <a
                            class="vacancy-edit-link"
                            asp-controller="EmployerVacancies"
                            asp-action="Edit"
                            asp-route-vacancyId="@vacancy.VacancyId">
                            <span aria-hidden="true">✎</span>
                            Edit
                        </a>

                        <form
                            id="vacancyStatusForm"
                            data-toggle-url="@Url.Action("ToggleStatus", "EmployerVacancies", new { vacancyId = vacancy.VacancyId })">
                            @Html.AntiForgeryToken()

                            <button
                                class="vacancy-status-toggle"
                                id="vacancyStatusToggle"
                                type="submit"
                                disabled="@(!vacancy.CanToggleStatus)">
                                <span id="vacancyStatusToggleIcon">
                                    @vacancy.ToggleIcon
                                </span>
                                <span id="vacancyStatusToggleLabel">
                                    @vacancy.ToggleLabel
                                </span>
                                <span
                                    class="vacancy-status-spinner"
                                    aria-hidden="true">
                                </span>
                            </button>
                        </form>

                        @if (!vacancy.IsClosed)
                        {
                            <form
                                id="vacancyCloseForm"
                                data-close-url="@Url.Action("CloseStatus", "EmployerVacancies", new { vacancyId = vacancy.VacancyId })">
                                @Html.AntiForgeryToken()
                                <button class="vacancy-status-toggle close-vacancy" id="vacancyCloseButton" type="submit">
                                    <span>✕</span><span>Close vacancy</span>
                                </button>
                            </form>
                        }
                    </div>
                </section>

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div
                        class="vacancy-status-message"
                        id="vacancyStatusMessage"
                        role="status"
                        aria-live="polite">
                        @Model.SuccessMessage
                    </div>
                }
                else
                {
                    <div
                        class="vacancy-status-message"
                        id="vacancyStatusMessage"
                        role="status"
                        aria-live="polite"
                        hidden>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CalendarSuccessMessage))
                {
                    <div class="calendar-message success" role="status">
                        <span>@Model.CalendarSuccessMessage</span>
                        @if (!string.IsNullOrWhiteSpace(Model.CalendarMeetingWebLink))
                        {
                            <a href="@Model.CalendarMeetingWebLink" target="_blank" rel="noopener noreferrer">
                                Open in Outlook
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.CalendarMeetingJoinUrl))
                        {
                            <a href="@Model.CalendarMeetingJoinUrl" target="_blank" rel="noopener noreferrer">
                                Join Teams meeting
                            </a>
                        }
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CalendarErrorMessage))
                {
                    <div class="calendar-message error" role="alert">
                        @Model.CalendarErrorMessage
                    </div>
                }

                <section class="outlook-connection-card" aria-label="Outlook calendar connection">
                    <div class="outlook-connection-icon" aria-hidden="true">O</div>
                    <div class="outlook-connection-copy">
                        <strong>Outlook Calendar</strong>
                        @if (Model.CalendarConnection.IsConnected)
                        {
                            <span>
                                Connected as <b>@Model.CalendarConnection.Email</b>
                            </span>
                        }
                        else if (!Model.CalendarConnection.IsConfigured)
                        {
                            <span>Microsoft Calendar server configuration is required.</span>
                        }
                        else
                        {
                            <span>Connect your Microsoft account to schedule candidate interviews.</span>
                        }
                    </div>
                    @if (Model.CalendarConnection.IsConnected)
                    {
                        <span class="outlook-connected-badge">Connected</span>
                        <form
                            method="post"
                            action="/Employer/Outlook/Disconnect"
                            class="outlook-disconnect-form">
                            @Html.AntiForgeryToken()
                            <input
                                type="hidden"
                                name="returnUrl"
                                value="@($"/Employer/Vacancies/{vacancy.VacancyId}")" />
                            <button type="submit">Disconnect</button>
                        </form>
                    }
                    else if (Model.CalendarConnection.IsConfigured)
                    {
                        <a
                            class="outlook-connect-button"
                            href="@Url.Action("Connect", "EmployerMicrosoftCalendar", new { returnUrl = $"/Employer/Vacancies/{vacancy.VacancyId}" })">
                            Connect Outlook
                        </a>
                    }
                </section>

                <section class="vacancy-metrics" aria-label="Vacancy analytics">
                    <article class="vacancy-metric-card best">
                        <span class="metric-icon">◎</span>
                        <div>
                            <small>Best match</small>
                            @if (vacancy.BestMatch is { } bestMetric)
                            {
                                <strong>@($"{bestMetric.MatchScore}%")</strong>
                                <p>@bestMetric.CandidateName</p>
                            }
                            else
                            {
                                <strong>—</strong>
                                <p>No applications yet</p>
                            }
                        </div>
                    </article>

                    <article class="vacancy-metric-card average">
                        <span class="metric-icon">▥</span>
                        <div>
                            <small>Average match</small>
                            <strong>@($"{vacancy.AverageMatchScore}%")</strong>
                            <p>from @vacancy.ApplicantCount applications</p>
                        </div>
                    </article>

                    <article class="vacancy-metric-card confidence">
                        <span class="metric-icon">♢</span>
                        <div>
                            <small>High confidence</small>
                            <strong>@vacancy.HighConfidenceCount</strong>
                            <p>Candidates with score ≥ 60</p>
                        </div>
                    </article>

                    <article class="vacancy-metric-card applicants">
                        <span class="metric-icon">♙</span>
                        <div>
                            <small>Applications</small>
                            <strong>@vacancy.TotalApplicationCount</strong>
                            <p>saved in SQL</p>
                        </div>
                    </article>

                    <article class="vacancy-metric-card deadline">
                        <span class="metric-icon">◷</span>
                        <div>
                            <small>Application window</small>
                            <strong>@vacancy.HiringWindowText</strong>
                            <p>
                                @(vacancy.ApplicationDeadline.HasValue
                                    ? $"until {vacancy.ApplicationDeadline.Value:dd.MM.yyyy}"
                                    : "no deadline")
                            </p>
                        </div>
                    </article>
                </section>

                <section class="best-match-panel">
                    <div class="section-heading">
                        <div>
                            <span class="section-kicker">TOP APPLICANT</span>
                            <h2>Best match</h2>
                            <p>
                                Highest skill match among candidates who applied
                                to this vacancy.
                            </p>
                        </div>
                    </div>

                    @if (vacancy.BestMatch is { } bestMatch)
                    {
                        <article class="best-match-card">
                            <div class="best-match-profile">
                                <span class="candidate-avatar large">
                                    @bestMatch.Initials
                                </span>
                                <div>
                                    <strong>@bestMatch.CandidateName</strong>
                                    <span>@bestMatch.CurrentRole</span>
                                    <small>@bestMatch.AppliedText</small>
                                </div>
                            </div>

                            <div class="best-match-skills">
                                <div>
                                    <small>Matched skills</small>
                                    <div class="skill-tags matched">
                                        @if (bestMatch.MatchedSkills.Count == 0)
                                        {
                                            <span>No matched skills</span>
                                        }
                                        else
                                        {
                                            @foreach (var skill in bestMatch.MatchedSkills.Take(6))
                                            {
                                                <span>@skill</span>
                                            }
                                        }
                                    </div>
                                </div>

                                <div>
                                    <small>Skill gaps</small>
                                    <div class="skill-tags missing">
                                        @if (bestMatch.MissingSkills.Count == 0)
                                        {
                                            <span>No skill gaps</span>
                                        }
                                        else
                                        {
                                            @foreach (var skill in bestMatch.MissingSkills.Take(6))
                                            {
                                                <span>@skill</span>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="best-match-score @bestMatch.ScoreCssClass">
                                <strong>@($"{bestMatch.MatchScore}%")</strong>
                                <span>skill match</span>
                            </div>
                        </article>
                    }
                    else
                    {
                        <div class="best-match-empty">
                            <span>◎</span>
                            <strong>No applications yet</strong>
                            <p>
                                Best match will be calculated after the first
                                candidate applies.
                            </p>
                        </div>
                    }
                </section>

                <nav class="vacancy-detail-tabs" aria-label="Vacancy sections">
                    <button
                        class="active"
                        type="button"
                        data-detail-tab="analytics">
                        ▥ Analytics
                    </button>
                    <button
                        type="button"
                        data-detail-tab="candidates">
                        ♙ Candidates
                        <span>@vacancy.ApplicantCount</span>
                    </button>
                    <button
                        type="button"
                        data-detail-tab="failed">
                        ⚠ Screening rejected
                        <span>@vacancy.FailedApplicantCount</span>
                    </button>
                    <button
                        type="button"
                        data-detail-tab="funnel">
                        ⑂ Funnel
                    </button>
                    <button
                        type="button"
                        data-detail-tab="settings">
                        ☷ Settings
                    </button>
                </nav>

                <section
                    class="vacancy-tab-panel active"
                    data-detail-panel="analytics">
                    <div class="analytics-grid">
                        <article class="detail-surface role-overview-card">
                            <div class="section-heading compact">
                                <div>
                                    <span class="section-kicker">ROLE PROFILE</span>
                                    <h2>Skill requirements</h2>
                                </div>
                            </div>

                            <div class="requirement-list">
                                @foreach (var skill in vacancy.Skills)
                                {
                                    <div class="requirement-row">
                                        <div>
                                            <strong>@skill.SkillName</strong>
                                            <span>@skill.RequirementType</span>
                                        </div>
                                        <div class="requirement-weight">
                                            <span style="@($"width:{skill.Weight}%")"></span>
                                        </div>
                                        <b>@skill.Weight</b>
                                    </div>
                                }
                            </div>
                        </article>

                        <article class="detail-surface vacancy-summary-card">
                            <div class="section-heading compact">
                                <div>
                                    <span class="section-kicker">VACANCY</span>
                                    <h2>Overview</h2>
                                </div>
                            </div>

                            <dl>
                                <div>
                                    <dt>Job family</dt>
                                    <dd>@vacancy.JobFamilyName</dd>
                                </div>
                                <div>
                                    <dt>Position</dt>
                                    <dd>@vacancy.PositionName</dd>
                                </div>
                                <div>
                                    <dt>Seniority</dt>
                                    <dd>@vacancy.SeniorityName</dd>
                                </div>
                                <div>
                                    <dt>Visibility</dt>
                                    <dd>@vacancy.Visibility</dd>
                                </div>
                                <div>
                                    <dt>Published</dt>
                                    <dd>
                                        @(vacancy.PublishDate.HasValue
                                            ? vacancy.PublishDate.Value.ToString("dd.MM.yyyy")
                                            : "Immediately")
                                    </dd>
                                </div>
                                <div>
                                    <dt>Platform ID</dt>
                                    <dd>@vacancy.PlatformVacancyId</dd>
                                </div>
                            </dl>
                        </article>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(vacancy.JobDescription))
                    {
                        <article class="detail-surface description-card">
                            <span class="section-kicker">DESCRIPTION</span>
                            <p>@vacancy.JobDescription</p>
                        </article>
                    }
                </section>

                <section
                    class="vacancy-tab-panel"
                    data-detail-panel="candidates"
                    hidden>
                    <article class="detail-surface candidates-panel">
                        <div class="section-heading">
                            <div>
                                <span class="section-kicker">APPLICATIONS</span>
                                <h2>Candidates ranked by skill match</h2>
                                <p>Only candidates who applied to this vacancy are shown.</p>
                            </div>
                        </div>

                        @if (vacancy.Applicants.Count == 0)
                        {
                            <div class="panel-empty-state">
                                <span>♙</span>
                                <strong>No candidates yet</strong>
                                <p>Applications will appear here automatically.</p>
                            </div>
                        }
                        else
                        {
                            <div class="candidate-ranking-list">
                                @for (var index = 0; index < vacancy.Applicants.Count; index++)
                                {
                                    var applicant = vacancy.Applicants[index];
                                    <article
                                        class="candidate-ranking-row candidate-ranking-clickable"
                                        role="button"
                                        tabindex="0"
                                        data-candidate-details="@applicant.ApplicationId"
                                        aria-label="View @applicant.CandidateName screening answers">
                                        <span class="candidate-rank">@(index + 1)</span>
                                        <span class="candidate-avatar">@applicant.Initials</span>
                                        <div class="candidate-ranking-copy">
                                            <strong>@applicant.CandidateName</strong>
                                            <span>@applicant.CurrentRole</span>
                                            <small>@applicant.AppliedText</small>
                                        </div>
                                        <span class="candidate-application-status">
                                            @applicant.ApplicationStatusLabel
                                        </span>
                                        @if (Model.CalendarConnection.IsConnected
                                            && !string.IsNullOrWhiteSpace(applicant.CandidateEmail))
                                        {
                                            <button
                                                class="candidate-schedule-button"
                                                type="button"
                                                data-schedule-meeting
                                                data-application-id="@applicant.ApplicationId"
                                                data-candidate-name="@applicant.CandidateName"
                                                data-candidate-email="@applicant.CandidateEmail"
                                                data-meeting-subject="@($"Interview — {vacancy.Title}")">
                                                Schedule
                                            </button>
                                        }
                                        <div class="candidate-score @applicant.ScoreCssClass">
                                            <strong>@($"{applicant.MatchScore}%")</strong>
                                            <span>match</span>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </article>
                </section>

                <section
                    class="vacancy-tab-panel"
                    data-detail-panel="failed"
                    hidden>
                    <article class="detail-surface candidates-panel failed-candidates-panel">
                        <div class="section-heading">
                            <div>
                                <span class="section-kicker">KNOCKOUT RESULTS</span>
                                <h2>Screening rejected candidates</h2>
                                <p>Candidates who selected an incorrect answer on a KnockOut question.</p>
                            </div>
                        </div>

                        @if (vacancy.FailedApplicants.Count == 0)
                        {
                            <div class="panel-empty-state">
                                <span>✓</span>
                                <strong>No screening rejections</strong>
                                <p>No candidate has failed a KnockOut question.</p>
                            </div>
                        }
                        else
                        {
                            <div class="candidate-ranking-list">
                                @for (var index = 0; index < vacancy.FailedApplicants.Count; index++)
                                {
                                    var applicant = vacancy.FailedApplicants[index];
                                    <article
                                        class="candidate-ranking-row candidate-ranking-clickable failed"
                                        role="button"
                                        tabindex="0"
                                        data-candidate-details="@applicant.ApplicationId"
                                        aria-label="View @applicant.CandidateName screening answers">
                                        <span class="candidate-rank">@(index + 1)</span>
                                        <span class="candidate-avatar">@applicant.Initials</span>
                                        <div class="candidate-ranking-copy">
                                            <strong>@applicant.CandidateName</strong>
                                            <span>@applicant.CurrentRole</span>
                                            <small>@applicant.AppliedText</small>
                                        </div>
                                        <span class="candidate-application-status failed">Screening rejected</span>
                                        <div class="candidate-score @applicant.ScoreCssClass">
                                            <strong>@($"{applicant.MatchScore}%")</strong>
                                            <span>match</span>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </article>
                </section>

                <section
                    class="vacancy-tab-panel"
                    data-detail-panel="funnel"
                    hidden>
                    <article class="detail-surface funnel-panel funnel-board-surface">
                        <div class="section-heading">
                            <div>
                                <span class="section-kicker">HIRING FLOW</span>
                                <h2>Vacancy funnel</h2>
                                <p>Drag candidates between the stages configured for this vacancy.</p>
                            </div>
                        </div>

                        <div
                            class="funnel-move-message"
                            id="funnelMoveMessage"
                            role="status"
                            hidden>
                        </div>

                        @if (vacancy.FunnelStages.Count == 0)
                        {
                            <div class="panel-empty-state">
                                <span>⑂</span>
                                <strong>No funnel stages</strong>
                            </div>
                        }
                        else
                        {
                            <div class="funnel-antiforgery-token" hidden>
                                @Html.AntiForgeryToken()
                            </div>

                            <div
                                class="funnel-board"
                                id="vacancyFunnelBoard"
                                data-vacancy-funnel-board>
                                @foreach (var stage in vacancy.FunnelStages)
                                {
                                    var stageApplicants = vacancy.AllApplicants
                                        .Where(applicant => string.Equals(
                                            applicant.FunnelStageName,
                                            stage.StageName,
                                            StringComparison.OrdinalIgnoreCase))
                                        .OrderByDescending(applicant => applicant.MatchScore)
                                        .ThenBy(applicant => applicant.AppliedAtUtc)
                                        .ToList();

                                    <section
                                        class="funnel-column"
                                        data-funnel-column
                                        data-stage-name="@stage.StageName">
                                        <header class="funnel-column-header">
                                            <div>
                                                <strong>@stage.StageName</strong>
                                                @if (stage.Hours > 0)
                                                {
                                                    <small>@stage.Hours h target</small>
                                                }
                                            </div>
                                            <span data-funnel-count>@stageApplicants.Count</span>
                                        </header>

                                        <div class="funnel-card-list" data-funnel-card-list>
                                            @foreach (var applicant in stageApplicants)
                                            {
                                                var isScreeningFailed = applicant.ApplicationStatus.Equals(
                                                    "ScreeningFailed",
                                                    StringComparison.OrdinalIgnoreCase);
                                                <article
                                                    class="funnel-candidate-card @(isScreeningFailed ? "screening-failed" : string.Empty)"
                                                    draggable="true"
                                                    tabindex="0"
                                                    data-funnel-card
                                                    data-application-id="@applicant.ApplicationId"
                                                    data-candidate-name="@applicant.CandidateName"
                                                    data-current-stage="@stage.StageName"
                                                    data-move-url="@Url.Action("MoveApplicantFunnelStage", "EmployerVacancies", new { vacancyId = vacancy.VacancyId, applicationId = applicant.ApplicationId })">
                                                    <strong>@applicant.CandidateName</strong>
                                                    <div>
                                                        <span class="funnel-match-dot"></span>
                                                        <span>@applicant.MatchScore% match</span>
                                                    </div>
                                                    @if (isScreeningFailed)
                                                    {
                                                        <small>Screening rejected</small>
                                                    }
                                                </article>
                                            }

                                            @if (stageApplicants.Count == 0)
                                            {
                                                <div class="funnel-column-empty" data-funnel-empty>
                                                    Empty
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="funnel-column-empty" data-funnel-empty hidden>
                                                    Empty
                                                </div>
                                            }
                                        </div>
                                    </section>
                                }
                            </div>

                            <p class="funnel-board-help">
                                Drag a candidate card and drop it into another column. Changes are saved immediately.
                            </p>
                        }
                    </article>
                </section>

                <section
                    class="vacancy-tab-panel"
                    data-detail-panel="settings"
                    hidden>
                    <article class="detail-surface settings-panel">
                        <div class="section-heading">
                            <div>
                                <span class="section-kicker">SETTINGS</span>
                                <h2>Publication state</h2>
                                <p>
                                    Pausing removes this vacancy from matching Candidate
                                    job results. Continue publishes it again.
                                </p>
                            </div>
                        </div>

                        <div class="settings-status-row">
                            <div>
                                <strong>Current status</strong>
                                <span id="settingsStatusText">@vacancy.StatusLabel</span>
                            </div>
                            <small>
                                Last updated @vacancy.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>
                    </article>
                </section>

                @foreach (var applicant in vacancy.Applicants.Concat(vacancy.FailedApplicants))
                {
                    <template data-candidate-answer-template="@applicant.ApplicationId">
                        <div class="candidate-answer-summary">
                            <span class="candidate-avatar large">@applicant.Initials</span>
                            <div>
                                <h2>@applicant.CandidateName</h2>
                                <p>@applicant.CurrentRole · @applicant.AppliedText</p>
                            </div>
                        </div>
                        <div class="candidate-answer-list">
                            @if (applicant.ScreeningAnswers.Count == 0)
                            {
                                <div class="candidate-answer-empty">No screening answers were submitted.</div>
                            }
                            else
                            {
                                @foreach (var answer in applicant.ScreeningAnswers)
                                {
                                    <article class="candidate-answer-item @answer.ResultCssClass">
                                        <div>
                                            <span>@answer.RequirementType · @answer.AnswerType</span>
                                            <h3>@answer.QuestionText</h3>
                                        </div>
                                        <p>@answer.Answer</p>
                                        <strong>@answer.ResultLabel</strong>
                                    </article>
                                }
                            }
                        </div>
                    </template>
                }

                <dialog class="candidate-answer-dialog" id="candidateAnswerDialog">
                    <button type="button" class="candidate-answer-close" data-candidate-answer-close aria-label="Close">×</button>
                    <div id="candidateAnswerDialogContent"></div>
                </dialog>

                <dialog class="meeting-dialog" id="meetingDialog">
                    <form
                        method="post"
                        action="/Employer/Outlook/Meetings"
                        data-availability-url="@Url.Action("Availability", "EmployerMicrosoftCalendar")"
                        id="meetingForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="vacancyId" value="@vacancy.VacancyId" />
                        <input type="hidden" name="applicationId" id="meetingApplicationId" />
                        <input type="hidden" name="startAtUtc" id="meetingStartAtUtc" />

                        <div class="meeting-dialog-heading">
                            <div>
                                <span class="section-kicker">OUTLOOK CALENDAR</span>
                                <h2>Schedule interview</h2>
                                <p id="meetingCandidateSummary"></p>
                            </div>
                            <button type="button" data-meeting-close aria-label="Close">×</button>
                        </div>

                        <label>
                            Subject
                            <input
                                type="text"
                                name="subject"
                                id="meetingSubject"
                                maxlength="240"
                                required />
                        </label>

                        <section class="meeting-availability" aria-label="Outlook availability">
                            <div class="meeting-availability-toolbar">
                                <div>
                                    <strong>Calendar availability</strong>
                                    <small>Click a free area or enter the time manually below.</small>
                                </div>
                                <div class="meeting-week-navigation">
                                    <button type="button" data-availability-previous aria-label="Previous week">‹</button>
                                    <button type="button" data-availability-today>Today</button>
                                    <button type="button" data-availability-next aria-label="Next week">›</button>
                                </div>
                            </div>

                            <div class="meeting-availability-range" id="meetingAvailabilityRange"></div>
                            <div class="meeting-availability-legend" aria-label="Calendar legend">
                                <span><i class="organizer"></i> HR busy</span>
                                <span><i class="candidate"></i> Candidate busy</span>
                                <span><i class="selection"></i> Selected time</span>
                            </div>
                            <div
                                class="meeting-availability-status"
                                id="meetingAvailabilityStatus"
                                role="status"
                                aria-live="polite">
                                Loading Outlook calendar…
                            </div>
                            <div
                                class="meeting-availability-calendar"
                                id="meetingAvailabilityCalendar"
                                aria-label="Weekly Outlook availability">
                            </div>
                            <div
                                class="candidate-availability-note"
                                id="candidateAvailabilityNote"
                                role="status">
                            </div>
                        </section>

                        <div class="meeting-form-grid meeting-date-time-grid">
                            <label>
                                Date
                                <input
                                    type="date"
                                    id="meetingDate"
                                    required />
                            </label>
                            <label>
                                Time
                                <input
                                    type="text"
                                    id="meetingTime"
                                    inputmode="numeric"
                                    autocomplete="off"
                                    maxlength="5"
                                    pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]"
                                    placeholder="09:30"
                                    aria-describedby="meetingTimeHelp"
                                    required />
                                <small id="meetingTimeHelp">24-hour format, for example 14:30</small>
                            </label>
                            <label>
                                Duration
                                <select name="durationMinutes">
                                    <option value="30">30 minutes</option>
                                    <option value="45">45 minutes</option>
                                    <option value="60" selected>1 hour</option>
                                    <option value="90">1 hour 30 minutes</option>
                                    <option value="120">2 hours</option>
                                </select>
                            </label>
                        </div>

                        <div
                            class="meeting-conflict-message"
                            id="meetingConflictMessage"
                            role="alert"
                            aria-live="polite"
                            hidden>
                        </div>

                        <label>
                            Agenda
                            <textarea
                                name="agenda"
                                rows="4"
                                maxlength="3000"
                                placeholder="Interview agenda or preparation notes"></textarea>
                        </label>

                        <label class="meeting-teams-option">
                            <input
                                type="checkbox"
                                name="createTeamsMeeting"
                                value="true"
                                checked />
                            <span>
                                <strong>Create Microsoft Teams meeting</strong>
                                <small>A Teams join link will be included in the Outlook invitation.</small>
                            </span>
                        </label>

                        <div class="meeting-dialog-actions">
                            <button type="button" data-meeting-close>Cancel</button>
                            <button type="submit">Create meeting &amp; send invite</button>
                        </div>
                    </form>
                </dialog>
            }
        </main>
    </div>

    <div
        class="employer-backdrop"
        id="employerBackdrop">
    </div>

    <script
        src="~/js/employer-home.js"
        asp-append-version="true">
    </script>
    <script
        src="~/js/employer-vacancy-detail.js"
        asp-append-version="true">
    </script>
</body>
</html>
