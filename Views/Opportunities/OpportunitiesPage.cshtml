@model GloryLikeWebApp.Models.OpportunitiesPageViewModel
@{
    Layout = null;
    var isStudent = User.FindFirst("accountType")?.Value == "student";
    ViewData["Title"] = "Opportunities";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BothFind</title>

    <link
        rel="stylesheet"
        href="~/css/candidate-dashboard.css"
        asp-append-version="true" />

    <link
        rel="stylesheet"
        href="~/css/opportunities-page.css"
        asp-append-version="true" />
</head>

<body>
    <form id="opportunityApplyToken" hidden>
        @Html.AntiForgeryToken()
    </form>

    <div class="dashboard-shell">
        <aside
            class="sidebar"
            id="dashboardSidebar">

            <a
                class="brand"
                href="/Portal/Home">
                <span class="brand-mark">ϟ</span>
                <span>BothFind</span>
            </a>

            @if (isStudent)
            {
                <partial name="_StudentWorkspaceNavigation" />
            }
            else
            {
            <nav
                class="nav-menu"
                aria-label="Candidate navigation">

                <a
                    class="nav-link"
                    asp-controller="Home"
                    asp-action="Index">
                    <span class="nav-icon">⌂</span>
                    <span>Dashboard</span>
                </a>

                <a
                    class="nav-link active"
                    asp-controller="Opportunities"
                    asp-action="OpportunitiesPage">
                    <span class="nav-icon">⌕</span>
                    <span>Jobs</span>
                </a>

                <a class="nav-link" asp-controller="Applications" asp-action="Index">
                    <span class="nav-icon">▣</span>
                    <span>Applications</span>
                </a>

                <a
                    class="nav-link"
                    asp-controller="Skills"
                    asp-action="SkillsPage">
                    <span class="nav-icon">✦</span>
                    <span>Skills</span>
                </a>

                <a
                    class="nav-link"
                    asp-controller="Profile"
                    asp-action="ProfilePage">
                    <span class="nav-icon">○</span>
                    <span>Profile</span>
                </a>
            </nav>
            }

            <div class="sidebar-bottom">
                <div class="growth-card">
                    <span class="growth-icon">⌕</span>
                    <strong>Job matching</strong>
                    <p>
                        Only active SQL Vacancies matching your
                        JobFamilyId are displayed.
                    </p>

                    <a
                        asp-controller="Skills"
                        asp-action="SkillsPage">
                        Review Job and skills
                    </a>
                </div>

                <form method="post" action="/SignOut">
                    @Html.AntiForgeryToken()

                    <button
                        type="submit"
                        class="signout-button">
                        <span>↪</span>
                        <span>Sign out</span>
                    </button>
                </form>
            </div>
        </aside>

        <main class="main-area opportunities-main-area">
            <header class="topbar">
                <button
                    class="mobile-menu-button"
                    id="mobileMenuButton"
                    type="button"
                    aria-label="Open menu">
                    ☰
                </button>

                <div class="opportunities-breadcrumb">
                    <a
                        asp-controller="Home"
                        asp-action="Index">
                        Dashboard
                    </a>

                    <span>›</span>
                    <strong>Opportunities</strong>
                </div>

                <div class="topbar-actions">
                    <partial name="_CandidateNotifications" />

                    <a class="account-chip" href="/Profile" aria-label="Open profile">
                        <div class="avatar">
                            @Model.Initials
                        </div>

                        <div class="account-copy">
                            <strong>@Model.DisplayName</strong>
                            <span>@(isStudent ? "Student" : "Candidate")</span>
                        </div>

                        <span class="chevron">⌄</span>
                    </a>
                </div>
            </header>

            <section class="opportunities-content">
                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <section class="opportunity-state success" role="status">
                        <span class="state-icon">✓</span>
                        <div>
                            <strong>Application submitted</strong>
                            <p>@Model.SuccessMessage</p>
                        </div>
                    </section>
                }

                <section class="opportunities-hero">
                    <div>
                        <span class="opportunities-eyebrow">
                            LIVE SQL VACANCIES
                        </span>

                        <h1>Opportunities</h1>

                        <p>
                            Employer vacancies appear here directly
                            when their JobFamilyId matches yours.
                        </p>

                        @if (Model.HasCurrentJob)
                        {
                            <span class="current-job-pill">
                                Current Job: @Model.CurrentJobName
                            </span>
                        }
                    </div>

                    <div class="hero-result-card">
                        <span>Available now</span>
                        <strong>@Model.Opportunities.Count</strong>
                        <small>@Model.RolesCountText</small>
                    </div>
                </section>

                <section class="opportunity-toolbar">
                    <form
                        class="opportunity-search"
                        method="get"
                        asp-controller="Opportunities"
                        asp-action="OpportunitiesPage">

                        <span>⌕</span>

                        <input
                            type="search"
                            name="search"
                            value="@Model.SearchText"
                            placeholder="Search matching roles or skills"
                            autocomplete="off" />

                        @if (!string.IsNullOrWhiteSpace(
                            Model.SearchText))
                        {
                            <a
                                class="clear-search"
                                asp-controller="Opportunities"
                                asp-action="OpportunitiesPage">
                                Clear
                            </a>
                        }

                        <button type="submit">
                            Search
                        </button>
                    </form>

                    <div
                        class="score-filters"
                        aria-label="Match score filters">

                        <button
                            type="button"
                            class="score-filter active"
                            data-score-filter="all">
                            All
                        </button>

                        <button
                            type="button"
                            class="score-filter"
                            data-score-filter="85">
                            85%+
                        </button>

                        <button
                            type="button"
                            class="score-filter"
                            data-score-filter="70">
                            70%+
                        </button>

                        <button
                            type="button"
                            class="score-filter"
                            data-score-filter="50">
                            50%+
                        </button>
                    </div>
                </section>

                @if (Model.HasError)
                {
                    <section class="opportunity-state error">
                        <span class="state-icon">!</span>
                        <div>
                            <strong>
                                Opportunities could not be loaded
                            </strong>
                            <p>@Model.ErrorMessage</p>
                        </div>
                    </section>
                }
                else if (Model.HasNoOpportunities)
                {
                    <section class="opportunity-state">
                        <span class="state-icon">⌕</span>
                        <div>
                            <strong>No matching roles</strong>
                            <p>@Model.EmptyMessage</p>

                            <a
                                asp-controller="Skills"
                                asp-action="SkillsPage">
                                Review Job and skills
                            </a>
                        </div>
                    </section>
                }
                else
                {
                    <div class="opportunities-heading">
                        <div>
                            <span class="opportunities-eyebrow">
                                FOR YOUR JOB
                            </span>
                            <h2>@Model.RolesCountText</h2>
                        </div>

                        <p>
                            Unrelated Job families are removed before
                            any match score is calculated.
                        </p>
                    </div>

                    <div
                        class="opportunities-list"
                        id="opportunitiesList">

                        @foreach (var opportunity in
                            Model.Opportunities)
                        {
                            <partial name="_OpportunityCard" model="opportunity" />
                        }
                    </div>

                    <section
                        class="client-filter-empty"
                        id="clientFilterEmpty"
                        hidden>
                        <strong>
                            No roles in this score range
                        </strong>
                        <p>
                            Select another score filter.
                        </p>
                    </section>
                }
            </section>
        </main>
    </div>

    <div
        class="sidebar-backdrop"
        id="sidebarBackdrop">
    </div>

    <script
        src="~/js/candidate-dashboard.js"
        asp-append-version="true">
    </script>

    <script
        src="~/js/candidate-notifications.js"
        asp-append-version="true">
    </script>

    <script
        src="~/js/opportunities-page.js"
        asp-append-version="true">
    </script>
</body>
</html>
