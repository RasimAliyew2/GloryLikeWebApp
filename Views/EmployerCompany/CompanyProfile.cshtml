@model GloryLikeWebApp.Models.Employer.CompanyProfilePageViewModel
@using GloryLikeWebApp.Models.Employer
@{
    Layout = null;
    ViewData["Title"] = "Company Profile";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SkillMatch</title>

    <link
        rel="stylesheet"
        href="~/css/employer-home.css"
        asp-append-version="true" />
    <link
        rel="stylesheet"
        href="~/css/company-profile.css"
        asp-append-version="true" />
    <link rel="stylesheet" href="~/css/company-public.css" asp-append-version="true" />
</head>

<body>
    <div class="employer-shell company-shell">
        <header class="employer-topbar">
            <a
                class="employer-brand"
                href="/Portal/Home">
                SkillMatch
            </a>

            <div class="employer-search">
                <span>⌕</span>
                <input
                    type="search"
                    placeholder="Search by candidates/vacancies"
                    aria-label="Search candidates or vacancies" />
            </div>

            <a class="employer-account" href="/Profile" aria-label="Open profile">
                <span class="demo-badge">Employer</span>

                <div class="employer-avatar">
                    @Model.Initials
                </div>

                <div class="employer-account-copy">
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.Email)
                            ? Model.DisplayName
                            : Model.Email)
                    </strong>
                    <span>Employer workspace</span>
                </div>

            </a>
        </header>

        <aside
            class="employer-sidebar"
            id="employerSidebar">
            <nav aria-label="Employer navigation">
                <a
                    asp-controller="EmployerHome"
                    asp-action="EmployerHome">
                    <span>⌁</span>
                    <strong>Dashboard</strong>
                </a>

                <a
                    asp-controller="EmployerVacancies"
                    asp-action="Index">
                    <span>▣</span>
                    <strong>Vacancies</strong>
                </a>

                <a href="#">
                    <span>▱</span>
                    <strong>Recruitment requests</strong>
                </a>

                <a
                    asp-controller="TalentRadar"
                    asp-action="Index">
                    <span>◎</span>
                    <strong>Talent Radar</strong>
                </a>

                <a
                    class="active"
                    asp-controller="EmployerCompany"
                    asp-action="Index">
                    <span>▥</span>
                    <strong>Company</strong>
                </a>

                <a
                    asp-controller="EmployerReports"
                    asp-action="Index">
                    <span>▧</span>
                    <strong>Reports</strong>
                </a>
            </nav>

            <div class="employer-sidebar-bottom">
                <form method="post" action="/SignOut">
                    @Html.AntiForgeryToken()
                    <button type="submit">↪ Sign out</button>
                </form>
            </div>
        </aside>

        <main class="employer-main company-main">
            <button
                class="employer-menu-button"
                type="button"
                id="employerMenuButton"
                aria-label="Open employer menu">
                ☰
            </button>

            <div class="company-profile-content">
                <nav class="company-tabs" aria-label="Company sections">
                    <a
                        class="active"
                        asp-controller="EmployerCompany"
                        asp-action="Index">
                        <span>♙</span>
                        Profile
                    </a>
                    <a
                        asp-controller="EmployerCompany"
                        asp-action="Structure">
                        <span>▱</span>
                        Structure
                    </a>
                    <a
                        asp-controller="EmployerCompany"
                        asp-action="Team">
                        <span>♧</span>
                        Team
                    </a>
                    <a
                        asp-controller="EmployerCompany"
                        asp-action="HiringPlan">
                        <span>◎</span>
                        Hiring Plan
                    </a>
                </nav>

                <section class="company-page-heading">
                    <div>
                        <h1>Company Profile</h1>
                        <p>
                            Candidates will see this information. Fill out your
                            profile — this is your career landing page.
                        </p>
                    </div>

                    <div class="company-heading-actions">
                        <button
                            class="company-secondary-button"
                            type="button"
                            id="companyShareButton"
                            @(Model.CompanyOwnerUserId <= 0 || !Model.Profile.UpdatedAtUtc.HasValue ? "disabled" : null)>
                            <span>↗</span>
                            Share
                        </button>
                        <button
                            class="company-secondary-button"
                            type="button"
                            id="companyPreviewButton">
                            <span>⊙</span>
                            Preview
                        </button>
                        <button
                            class="company-primary-button"
                            type="button"
                            id="companySaveButton">
                            <span>▣</span>
                            Save
                        </button>
                    </div>
                </section>

                <section class="company-completion" aria-label="Profile completion">
                    <div class="company-completion-track">
                        <span id="companyCompletionBar"></span>
                    </div>
                    <strong id="companyCompletionValue">0% Filled</strong>
                    <small>Complete the profile completely for better visibility</small>
                </section>

                <form
                    class="company-profile-form"
                    id="companyProfileForm"
                    asp-controller="EmployerCompany"
                    asp-action="SaveProfile"
                    method="post"
                    novalidate>
                    @Html.AntiForgeryToken()

                    <input
                        id="companyLogoDataUrl"
                        name="LogoDataUrl"
                        type="hidden"
                        data-profile-field />
                    <input id="companyCoverImageDataUrl" name="CoverImageDataUrl" type="hidden" data-profile-field />
                    <input id="companyAboutPageLayoutJson" name="AboutPageLayoutJson" type="hidden" value="@CompanyAboutPageDefaults.LayoutJson" />
                    <textarea id="companyAboutPageCustomHtml" name="AboutPageCustomHtml" hidden></textarea>
                    <input id="companyUseCustomAboutPageHtml" name="UseCustomAboutPageHtml" type="hidden" value="false" />

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="company-profile-alert" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    <section class="company-form-card">
                        <h2>Basic information</h2>

                        <div class="company-field full-width">
                            <label for="companyName">Company Name *</label>
                            <input
                                id="companyName"
                                name="companyName"
                                type="text"
                                maxlength="150"
                                placeholder="OOO Horns and Hooves"
                                autocomplete="organization"
                                data-profile-field
                                required />
                            <small class="company-field-error" id="companyNameError"></small>
                        </div>

                        <div class="company-form-grid">
                            <div class="company-field">
                                <label for="companyType">Company Type</label>
                                <select
                                    id="companyType"
                                    name="companyType"
                                    data-profile-field>
                                    <option value="">Select company type</option>
                                    <option>Startup</option>
                                    <option>SME</option>
                                    <option>Enterprise</option>
                                    <option>Government</option>
                                    <option>Non-profit</option>
                                </select>
                            </div>

                            <div class="company-field">
                                <label for="activityScope">Scope of activity</label>
                                <select
                                    id="activityScope"
                                    name="activityScope"
                                    data-profile-field>
                                    <option value="">Select a field of activity</option>
                                    <option>Information Technology</option>
                                    <option>Finance and Banking</option>
                                    <option>Telecommunications</option>
                                    <option>Retail and E-commerce</option>
                                    <option>Education</option>
                                    <option>Healthcare</option>
                                    <option>Manufacturing</option>
                                    <option>Professional Services</option>
                                </select>
                            </div>

                            <div class="company-field">
                                <label for="foundationYear">Year of foundation</label>
                                <input
                                    id="foundationYear"
                                    name="foundationYear"
                                    type="number"
                                    min="1800"
                                    max="2100"
                                    inputmode="numeric"
                                    placeholder="2015"
                                    data-profile-field />
                            </div>

                            <div class="company-field">
                                <label for="employeeCount">Number of employees</label>
                                <select
                                    id="employeeCount"
                                    name="employeeCount"
                                    data-profile-field>
                                    <option value="">Select</option>
                                    <option>1–10</option>
                                    <option>11–50</option>
                                    <option>51–200</option>
                                    <option>201–500</option>
                                    <option>501–1000</option>
                                    <option>1000+</option>
                                </select>
                            </div>

                            <div class="company-field">
                                <label for="website">Website</label>
                                <input
                                    id="website"
                                    name="website"
                                    type="url"
                                    maxlength="240"
                                    placeholder="https://company.az"
                                    autocomplete="url"
                                    data-profile-field />
                            </div>

                            <div class="company-field">
                                <label for="pageLanguage">Language of the company page</label>
                                <select
                                    id="pageLanguage"
                                    name="pageLanguage"
                                    data-profile-field>
                                    <option value="">Select language</option>
                                    <option>Azərbaycan dili</option>
                                    <option>English</option>
                                    <option>Russian</option>
                                    <option>Turkish</option>
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="company-form-card">
                        <h2>Media &amp; branding</h2>

                        <div class="company-form-grid company-upload-grid">
                            <div class="company-field">
                                <label>Logo</label>
                                <label class="company-upload-tile" for="companyLogo">
                                    <input
                                        id="companyLogo"
                                        name="companyLogo"
                                        type="file"
                                        accept="image/jpeg,image/png"
                                        data-max-size="5242880"
                                        data-upload-kind="Logo"
                                        data-profile-field />
                                    <img
                                        class="company-logo-upload-preview"
                                        id="companyLogoUploadPreview"
                                        alt="Company logo preview"
                                        hidden />
                                    <span class="company-upload-icon">⇧</span>
                                    <strong data-upload-title>Logo</strong>
                                    <small data-upload-caption>
                                        JPG or PNG source · Max. 5MB. Saved as 512×512 px and max. 350KB; crop is available before saving.
                                    </small>
                                </label>
                            </div>

                            <div class="company-field">
                                <label>Cover</label>
                                <label class="company-upload-tile" for="companyCover">
                                    <input
                                        id="companyCover"
                                        name="companyCover"
                                        type="file"
                                        accept="image/jpeg,image/png"
                                        data-max-size="5242880"
                                        data-upload-kind="Cover"
                                        data-profile-field />
                                    <img
                                        class="company-cover-upload-preview"
                                        id="companyCoverUploadPreview"
                                        alt="Company cover preview"
                                        hidden />
                                    <span class="company-upload-icon">⇧</span>
                                    <strong data-upload-title>Cover</strong>
                                    <small data-upload-caption>
                                        JPG or PNG source · Max. 5MB. Saved as 1600×600 px and max. 700KB; crop is available before saving.
                                    </small>
                                </label>
                            </div>
                        </div>

                        <div class="company-field company-gallery-field">
                            <label>Photo Gallery</label>
                            <small>Recommended size: 800×600 px · JPG or PNG · Max. 3MB each · up to 8 photos</small>

                            <div class="company-gallery" id="companyGallery">
                                <label class="company-gallery-add" for="companyGalleryFiles">
                                    <input
                                        id="companyGalleryFiles"
                                        name="companyGalleryFiles"
                                        type="file"
                                        accept="image/jpeg,image/png"
                                        multiple
                                        data-max-size="3145728"
                                        data-profile-field />
                                    <span>＋</span>
                                    <strong>Add photo</strong>
                                </label>
                            </div>
                        </div>

                        <div class="company-field full-width">
                            <label for="companyVideo">Company Video (YouTube / Vimeo)</label>
                            <input
                                id="companyVideo"
                                name="companyVideo"
                                type="url"
                                maxlength="240"
                                placeholder="https://youtube.com/watch?v=..."
                                data-profile-field />
                        </div>
                    </section>

                    <section class="company-form-card company-about-builder-card">
                        <div class="company-card-heading-row">
                            <div>
                                <h2>About page layout</h2>
                                <p>Move sections up or down. This order is used by Preview and the public share link.</p>
                            </div>
                            <span class="company-about-mode" id="companyAboutMode">Standard layout</span>
                        </div>

                        <div class="company-layout-list" id="companyLayoutList">
                            @foreach (var layoutSection in new[]
                            {
                                ("media", "Cover & logo", "Company imagery and identity"),
                                ("about", "About", "Company description"),
                                ("culture", "Culture", "Culture and why work with us"),
                                ("benefits", "Benefits", "Bonuses and benefits"),
                                ("locations", "Locations", "Offices and branches"),
                                ("vacancies", "Vacancies", "Public job opportunities"),
                                ("contact", "Contact", "Website and social links")
                            })
                            {
                                <article class="company-layout-item" data-layout-key="@layoutSection.Item1">
                                    <span class="company-layout-handle" aria-hidden="true">⋮⋮</span>
                                    <div><strong>@layoutSection.Item2</strong><small>@layoutSection.Item3</small></div>
                                    <div class="company-layout-actions">
                                        <button type="button" data-layout-up aria-label="Move @layoutSection.Item2 up">↑</button>
                                        <button type="button" data-layout-down aria-label="Move @layoutSection.Item2 down">↓</button>
                                    </div>
                                </article>
                            }
                        </div>

                        <div class="company-customize-actions">
                            <button class="company-secondary-button" id="companyCustomizeHtmlButton" type="button">&lt;/&gt; Customize your about page with HTML</button>
                            <button class="company-ai-button" id="companyCustomizeAiButton" type="button"><span>✦</span> Customize your about page with AI</button>
                        </div>
                        <p class="company-security-note">Custom HTML is sanitized before it is saved. Scripts, forms, tracking, redirects and external embeds are not allowed.</p>
                    </section>

                    <section class="company-form-card">
                        <h2>About the company</h2>

                        <div class="company-field full-width">
                            <label for="companyDescription">Description</label>
                            <textarea
                                id="companyDescription"
                                name="companyDescription"
                                rows="5"
                                maxlength="2500"
                                placeholder="Tell us about the company..."
                                data-profile-field></textarea>
                        </div>
                    </section>

                    <section class="company-form-card">
                        <h2>Life in the company</h2>

                        <div class="company-field full-width">
                            <label for="companyCulture">Culture and values</label>
                            <textarea
                                id="companyCulture"
                                name="companyCulture"
                                rows="4"
                                maxlength="1600"
                                placeholder="Describe the culture of the company..."
                                data-profile-field></textarea>
                        </div>

                        <div class="company-field full-width">
                            <label for="whyWorkWithUs">Why work with us</label>
                            <textarea
                                id="whyWorkWithUs"
                                name="whyWorkWithUs"
                                rows="4"
                                maxlength="1600"
                                placeholder="What attracts employees..."
                                data-profile-field></textarea>
                        </div>

                        <div class="company-field full-width company-benefit-field">
                            <label for="benefitInput">Bonuses and benefits</label>
                            <div class="company-benefit-entry">
                                <input
                                    id="benefitInput"
                                    type="text"
                                    maxlength="70"
                                    placeholder="Add bonus..." />
                                <button
                                    type="button"
                                    id="addBenefitButton"
                                    aria-label="Add benefit">
                                    ＋
                                </button>
                            </div>

                            <div
                                class="company-benefit-list"
                                id="companyBenefitList"
                                data-profile-field>
                            </div>

                            <div
                                class="company-benefit-suggestions"
                                id="companyBenefitSuggestions"
                                aria-label="Benefit suggestions"
                                hidden>
                            </div>
                            <small>
                                Start typing to search the Employee Benefits List. You can also add your own custom benefit.
                            </small>
                        </div>
                    </section>

                    <section class="company-form-card">
                        <div class="company-card-heading-row">
                            <div>
                                <h2>Locations</h2>
                                <p>Add every office or branch that can hire employees.</p>
                            </div>
                            <button
                                class="company-secondary-button company-add-location"
                                id="addCompanyLocationButton"
                                type="button">
                                ＋ Add location
                            </button>
                        </div>

                        <div
                            class="company-location-list"
                            id="companyLocationList">
                        </div>
                    </section>

                    <section class="company-form-card">
                        <h2>Social media</h2>

                        <div class="company-social-list">
                            <label class="company-social-field" for="linkedInUrl">
                                <span>in</span>
                                <input
                                    id="linkedInUrl"
                                    name="linkedInUrl"
                                    type="url"
                                    maxlength="240"
                                    placeholder="https://linkedin.com/company/..."
                                    aria-label="LinkedIn URL"
                                    data-profile-field />
                            </label>

                            <label class="company-social-field" for="instagramUrl">
                                <span>◎</span>
                                <input
                                    id="instagramUrl"
                                    name="instagramUrl"
                                    type="url"
                                    maxlength="240"
                                    placeholder="https://instagram.com/..."
                                    aria-label="Instagram URL"
                                    data-profile-field />
                            </label>

                            <label class="company-social-field" for="facebookUrl">
                                <span>f</span>
                                <input
                                    id="facebookUrl"
                                    name="facebookUrl"
                                    type="url"
                                    maxlength="240"
                                    placeholder="https://facebook.com/..."
                                    aria-label="Facebook URL"
                                    data-profile-field />
                            </label>

                            <label class="company-social-field" for="youtubeUrl">
                                <span>▶</span>
                                <input
                                    id="youtubeUrl"
                                    name="youtubeUrl"
                                    type="url"
                                    maxlength="240"
                                    placeholder="https://youtube.com/@@..."
                                    aria-label="YouTube URL"
                                    data-profile-field />
                            </label>

                            <label class="company-social-field" for="telegramUrl">
                                <span>◉</span>
                                <input
                                    id="telegramUrl"
                                    name="telegramUrl"
                                    type="url"
                                    maxlength="240"
                                    placeholder="https://t.me/..."
                                    aria-label="Telegram URL"
                                    data-profile-field />
                            </label>

                            <label class="company-social-field" for="tiktokUrl">
                                <span>♪</span>
                                <input
                                    id="tiktokUrl"
                                    name="tiktokUrl"
                                    type="url"
                                    maxlength="240"
                                    placeholder="https://tiktok.com/@@..."
                                    aria-label="TikTok URL"
                                    data-profile-field />
                            </label>
                        </div>
                    </section>
                </form>
            </div>
        </main>
    </div>

    <div
        class="employer-backdrop"
        id="employerBackdrop">
    </div>

    <dialog class="company-preview-dialog company-full-preview-dialog" id="companyPreviewDialog">
        <div class="company-preview-toolbar">
            <div>
                <strong>Live company page preview</strong>
                <span>Exactly the same renderer is used by the public link.</span>
            </div>
            <button
                type="button"
                id="companyPreviewClose"
                aria-label="Close preview">
                ×
            </button>
        </div>
        <div class="company-public-nav company-preview-public-nav">
            <span class="company-public-brand">SkillMatch</span>
            <div class="company-public-nav-actions"><span>About</span><span>Vacancies</span><span class="primary">Sign up</span></div>
        </div>
        <div class="company-public-root company-editor-preview-root" id="companyPreviewRoot"></div>
    </dialog>

    <dialog class="company-logo-crop-dialog" id="companyLogoCropDialog">
        <div class="company-logo-crop-header">
            <div>
                <span>COMPANY LOGO</span>
                <h2>Crop image</h2>
            </div>
            <button
                type="button"
                id="companyLogoCropClose"
                aria-label="Close crop editor">×</button>
        </div>

        <div class="company-logo-crop-body">
            <div class="company-logo-crop-stage" id="companyLogoCropStage">
                <canvas
                    id="companyLogoCropCanvas"
                    width="520"
                    height="520"
                    aria-label="Company logo crop preview"></canvas>
                <div class="company-logo-crop-guide" aria-hidden="true"></div>
            </div>

            <div class="company-logo-crop-controls">
                <label for="companyLogoCropZoom">Zoom</label>
                <input
                    id="companyLogoCropZoom"
                    type="range"
                    min="1"
                    max="3"
                    value="1"
                    step="0.01" />
                <p>
                    Drag the image to position it inside the circle. The saved
                    file is limited to 512×512 px and 350KB.
                </p>
            </div>
        </div>

        <div class="company-logo-crop-footer">
            <button
                class="company-secondary-button"
                id="companyLogoCropCancel"
                type="button">Cancel</button>
            <button
                class="company-primary-button"
                id="companyLogoCropSave"
                type="button">Save crop</button>
        </div>
    </dialog>

    <dialog class="company-logo-crop-dialog company-cover-crop-dialog" id="companyCoverCropDialog">
        <div class="company-logo-crop-header">
            <div><span>COMPANY COVER</span><h2>Crop cover image</h2></div>
            <button type="button" id="companyCoverCropClose" aria-label="Close cover crop editor">×</button>
        </div>
        <div class="company-logo-crop-body">
            <div class="company-logo-crop-stage company-cover-crop-stage" id="companyCoverCropStage">
                <canvas id="companyCoverCropCanvas" width="800" height="300" aria-label="Company cover crop preview"></canvas>
                <div class="company-cover-crop-guide" aria-hidden="true"></div>
            </div>
            <div class="company-logo-crop-controls">
                <label for="companyCoverCropZoom">Zoom</label>
                <input id="companyCoverCropZoom" type="range" min="1" max="3" value="1" step="0.01" />
                <p>Drag the image to position it inside the 8:3 frame. The saved file is 1600×600 px and max. 700KB.</p>
            </div>
        </div>
        <div class="company-logo-crop-footer">
            <button class="company-secondary-button" id="companyCoverCropCancel" type="button">Cancel</button>
            <button class="company-primary-button" id="companyCoverCropSave" type="button">Save crop</button>
        </div>
    </dialog>

    <dialog class="company-share-dialog" id="companyShareDialog">
        <div class="company-dialog-heading">
            <div><span>PUBLIC COMPANY PAGE</span><h2>Share company page</h2></div>
            <button type="button" id="companyShareCloseIcon" aria-label="Close share dialog">×</button>
        </div>
        <p>Anyone with this link can view the company page and public vacancies without signing in.</p>
        <div class="company-share-link-row">
            <input id="companyShareLink" type="text" readonly />
            <button class="company-primary-button" id="companyCopyShareLink" type="button">Copy</button>
        </div>
        <div class="company-dialog-footer"><button class="company-secondary-button" id="companyShareClose" type="button">Close</button></div>
    </dialog>

    <dialog class="company-html-dialog" id="companyHtmlDialog" data-ai-url="/Employer/Company/AboutPage/Ai">
        <div class="company-dialog-heading">
            <div><span>SAFE HTML CUSTOMIZER</span><h2>Customize your about page</h2></div>
            <button type="button" id="companyHtmlClose" aria-label="Close HTML editor">×</button>
        </div>
        <div class="company-html-dialog-body">
            <div class="company-html-editor-panel">
                <div class="company-html-tabs" role="tablist">
                    <button class="active" id="companyHtmlTab" type="button">HTML</button>
                    <button id="companyAiTab" type="button"><span>✦</span> AI designer</button>
                </div>
                <div id="companyHtmlPanel">
                    <label for="companyHtmlEditor">About page HTML</label>
                    <textarea id="companyHtmlEditor" spellcheck="false" maxlength="60000">@(string.IsNullOrWhiteSpace(Model.Profile.AboutPageCustomHtml) ? CompanyAboutPageDefaults.CustomHtml : Model.Profile.AboutPageCustomHtml)</textarea>
                    <small>Use the existing <code>data-company-field</code> hooks to keep profile content dynamic.</small>
                </div>
                <div id="companyAiPanel" hidden>
                    <label for="companyAiPrompt">Describe your desired design</label>
                    <textarea id="companyAiPrompt" maxlength="1500" placeholder="Example: Use a clean dark hero, softer cards and a more editorial typography style. Keep all current sections."></textarea>
                    <button class="company-ai-button" id="companyRunAiButton" type="button"><span>✦</span> Generate safe HTML</button>
                    <div class="company-ai-message" id="companyAiMessage" role="status" aria-live="polite"></div>
                </div>
                <label class="company-custom-html-toggle"><input id="companyCustomHtmlEnabled" type="checkbox" /> Use custom HTML on the public page</label>
            </div>
            <div class="company-html-preview-panel">
                <strong>Safe preview</strong>
                <div class="company-public-root" id="companyHtmlPreviewRoot"></div>
            </div>
        </div>
        <div class="company-dialog-footer">
            <button class="company-secondary-button" id="companyHtmlCancel" type="button">Cancel</button>
            <button class="company-primary-button" id="companyHtmlApply" type="button">Apply design</button>
        </div>
    </dialog>

    <div
        class="company-toast"
        id="companyToast"
        role="status"
        aria-live="polite">
    </div>

    <script
        src="~/js/employer-home.js"
        asp-append-version="true">
    </script>
    <script type="application/json" id="companyProfileInitialData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Profile, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
    <script type="application/json" id="companyBenefitCatalog">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BenefitSuggestions))</script>
    <script type="application/json" id="companyPageContext">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { companyOwnerUserId = Model.CompanyOwnerUserId }))</script>
    <script src="~/js/company-public.js" asp-append-version="true"></script>
    <script
        src="~/js/company-profile.js"
        asp-append-version="true">
    </script>
</body>
</html>
