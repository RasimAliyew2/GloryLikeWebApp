@model GloryLikeWebApp.Models.Auth.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Log in";
    var googleAuthenticationEnabled =
        ViewData["GoogleAuthenticationEnabled"] is true;
    var appleAuthenticationEnabled =
        ViewData["AppleAuthenticationEnabled"] is true;
    var encodedReturnUrl = Uri.EscapeDataString(
        Model?.ReturnUrl ?? string.Empty);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sign in securely to your BothFind candidate or employer account." />
    <meta name="robots" content="noindex, follow" />
    <title>@ViewData["Title"] - BothFind</title>
    <style>
        :root {
            --blue: #4f86f7;
            --blue-dark: #356fe4;
            --text: #111827;
            --muted: #98a2b3;
            --line: #e4e7ec;
            --surface: #ffffff;
            --page: #f8fafc;
            --navy: #111827;
            --danger: #d92d20;
        }

        * { box-sizing: border-box; }

        html, body { min-height: 100%; }

        body {
            margin: 0;
            font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--text);
            background: var(--page);
        }

        button, input { font: inherit; }

        .topbar {
            height: 64px;
            padding: 0 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff;
            border-bottom: 1px solid #eef1f5;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            font-size: 18px;
            font-weight: 800;
            color: #101828;
            text-decoration: none;
        }

        .brand-mark {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            color: white;
            background: linear-gradient(145deg, #5b95ff, #3f7cf1);
            box-shadow: 0 8px 18px rgba(79, 134, 247, .26);
            font-size: 17px;
        }

        .top-login {
            color: #98a2b3;
            font-size: 15px;
        }

        .top-login a {
            margin-left: 10px;
            color: #3676ee;
            text-decoration: none;
            font-weight: 700;
        }

        .page-shell {
            min-height: calc(100vh - 64px);
            padding: 54px 20px 64px;
            display: flex;
            align-items: flex-start;
            justify-content: center;
        }

        .auth-card {
            width: min(520px, 100%);
            background: var(--surface);
            border: 1px solid #dfe4ea;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 12px 32px rgba(16, 24, 40, .05);
        }

        .tabs {
            height: 64px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-bottom: 1px solid #eaecf0;
        }

        .tab {
            position: relative;
            display: grid;
            place-items: center;
            color: #98a2b3;
            font-weight: 700;
            text-decoration: none;
        }

        .tab.active { color: #3676ee; }

        .tab.active::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 3px;
            background: #4f86f7;
        }

        .card-body { padding: 34px 38px 32px; }

        h1 {
            margin: 0 0 6px;
            font-size: 27px;
            line-height: 1.2;
            letter-spacing: -.03em;
        }

        .subtitle {
            margin: 0 0 26px;
            color: #98a2b3;
            font-size: 16px;
            line-height: 1.5;
        }

        .section-label,
        .field-label {
            display: block;
            color: #667085;
            font-size: 13px;
            font-weight: 800;
            letter-spacing: .02em;
        }

        .section-label { margin-bottom: 14px; }
        .field-label { margin: 0 0 9px; }

        .social-stack {
            display: grid;
            gap: 12px;
        }

        .social-button {
            width: 100%;
            min-height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 13px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
        }

        .social-button.disabled {
            cursor: not-allowed;
            opacity: .55;
        }

        .google {
            color: #1d2939;
            background: #fff;
            border: 1px solid #d9dee6;
        }

        .apple {
            color: white;
            background: #111827;
            border: 1px solid #111827;
        }

        .social-icon {
            width: 22px;
            text-align: center;
            font-size: 19px;
            font-weight: 800;
        }

        .google .social-icon { color: #4285f4; }

        .divider {
            margin: 24px 0;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 14px;
            align-items: center;
            color: #98a2b3;
            font-size: 14px;
        }

        .divider::before,
        .divider::after {
            content: "";
            height: 1px;
            background: #dfe4ea;
        }

        .field { margin-bottom: 20px; }

        .input {
            width: 100%;
            height: 52px;
            padding: 0 15px;
            color: #344054;
            background: #fff;
            border: 1px solid #d9dee6;
            border-radius: 14px;
            outline: none;
            transition: border-color .15s ease, box-shadow .15s ease;
        }

        .input::placeholder { color: #98a2b3; }

        .input:focus {
            border-color: #6a9af6;
            box-shadow: 0 0 0 4px rgba(79, 134, 247, .12);
        }

        .validation-summary {
            margin: 0 0 18px;
            padding: 12px 14px;
            color: var(--danger);
            background: #fff4f2;
            border: 1px solid #fecdca;
            border-radius: 12px;
            font-size: 14px;
        }

        .validation-summary:empty,
        .validation-summary.validation-summary-valid { display: none; }

        .field-error {
            display: block;
            margin-top: 7px;
            color: var(--danger);
            font-size: 13px;
        }

        .field-error:empty { display: none; }

        .forgot-row {
            margin: -3px 0 22px;
            text-align: right;
        }

        .forgot-row a,
        .create-row a {
            color: #3676ee;
            text-decoration: none;
            font-weight: 700;
        }

        .forgot-row a { font-size: 14px; }

        .submit-button {
            width: 100%;
            height: 54px;
            border: 0;
            border-radius: 14px;
            color: white;
            background: linear-gradient(135deg, #5590fa, #477ff0);
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 10px 24px rgba(79, 134, 247, .22);
            transition: transform .15s ease, filter .15s ease;
        }

        .submit-button:hover {
            filter: brightness(.98);
            transform: translateY(-1px);
        }

        .create-row {
            margin-top: 22px;
            text-align: center;
            color: #98a2b3;
            font-size: 14px;
        }

        .auth-footer {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 0 20px 28px;
            color: #98a2b3;
            font-size: 13px;
        }

        .auth-footer a {
            color: #667085;
            font-weight: 650;
            text-decoration: none;
        }

        .auth-footer a:hover,
        .auth-footer a:focus-visible {
            color: #3676ee;
            text-decoration: underline;
        }

        @@media (max-width: 620px) {
            .topbar { padding: 0 18px; }
            .top-login span { display: none; }
            .page-shell { padding: 26px 14px 40px; }
            .card-body { padding: 28px 22px 26px; }
            h1 { font-size: 24px; }
        }
    </style>
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/">
            <span class="brand-mark">ϟ</span>
            <span>BothFind</span>
        </a>

        <div class="top-login">
            <span>Already have an account?</span>
            <a href="/SignIn">Log in</a>
        </div>
    </header>

    <main class="page-shell">
        <section class="auth-card" aria-labelledby="login-title">
            <div class="tabs">
                <a class="tab" href="/Registration?accountType=candidate&amp;returnUrl=@encodedReturnUrl">Registration</a>
                <a class="tab active" href="/SignIn">Login</a>
            </div>

            <div class="card-body">
                <h1 id="login-title">Log in to your account</h1>
                <p class="subtitle">Enter your email, username or phone and password, or log in via social media.</p>

                <div class="section-label">LOG IN WITH</div>

                @if (TempData["ExternalLoginError"] is string externalLoginError
                    && !string.IsNullOrWhiteSpace(externalLoginError))
                {
                    <div class="validation-summary">@externalLoginError</div>
                }
                else if (ViewData["ExternalLoginError"] is string providerError
                    && !string.IsNullOrWhiteSpace(providerError))
                {
                    <div class="validation-summary">@providerError</div>
                }

                <div class="social-stack">
                    @if (googleAuthenticationEnabled)
                    {
                        <a class="social-button google" href="/SignIn/External/google?returnUrl=@encodedReturnUrl">
                            <span class="social-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18">
                                    <path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.06H12v3.9h5.38a4.6 4.6 0 0 1-2 3.02v2.53h3.24c1.9-1.75 2.98-4.33 2.98-7.39z" />
                                    <path fill="#34A853" d="M12 22c2.7 0 4.98-.9 6.63-2.38l-3.24-2.53c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.6A10 10 0 0 0 12 22z" />
                                    <path fill="#FBBC05" d="M6.39 13.92A6.02 6.02 0 0 1 6.07 12c0-.67.11-1.32.32-1.92v-2.6H3.04A10 10 0 0 0 2 12c0 1.61.39 3.13 1.04 4.52l3.35-2.6z" />
                                    <path fill="#EA4335" d="M12 5.95c1.47 0 2.79.5 3.82 1.49l2.88-2.88A9.65 9.65 0 0 0 12 2a10 10 0 0 0-8.96 5.48l3.35 2.6C7.18 7.71 9.39 5.95 12 5.95z" />
                                </svg>
                            </span>
                            <span>Sign in with Google</span>
                        </a>
                    }
                    else
                    {
                        <span class="social-button google disabled"
                              aria-disabled="true"
                              title="Google sign in is not configured">
                            <span class="social-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18">
                                    <path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.06H12v3.9h5.38a4.6 4.6 0 0 1-2 3.02v2.53h3.24c1.9-1.75 2.98-4.33 2.98-7.39z" />
                                    <path fill="#34A853" d="M12 22c2.7 0 4.98-.9 6.63-2.38l-3.24-2.53c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.6A10 10 0 0 0 12 22z" />
                                    <path fill="#FBBC05" d="M6.39 13.92A6.02 6.02 0 0 1 6.07 12c0-.67.11-1.32.32-1.92v-2.6H3.04A10 10 0 0 0 2 12c0 1.61.39 3.13 1.04 4.52l3.35-2.6z" />
                                    <path fill="#EA4335" d="M12 5.95c1.47 0 2.79.5 3.82 1.49l2.88-2.88A9.65 9.65 0 0 0 12 2a10 10 0 0 0-8.96 5.48l3.35 2.6C7.18 7.71 9.39 5.95 12 5.95z" />
                                </svg>
                            </span>
                            <span>Sign in with Google</span>
                        </span>
                    }

                    @if (appleAuthenticationEnabled)
                    {
                        <a class="social-button apple" href="/SignIn/External/apple?returnUrl=@encodedReturnUrl">
                            <span class="social-icon">●</span>
                            <span>Sign in with Apple</span>
                        </a>
                    }
                    else
                    {
                        <span class="social-button apple disabled"
                              aria-disabled="true"
                              title="Apple sign in is not configured">
                            <span class="social-icon">●</span>
                            <span>Sign in with Apple</span>
                        </span>
                    }
                </div>

                <div class="divider">or</div>

                <form asp-controller="Account" asp-action="SignIn" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                    <div class="field">
                        <label asp-for="Login" class="field-label">EMAIL, USERNAME OR PHONE</label>
                        <input
                            asp-for="Login"
                            class="input"
                            autocomplete="username"
                            placeholder="you@example.com" />
                        <span asp-validation-for="Login" class="field-error"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password" class="field-label">PASSWORD</label>
                        <input
                            asp-for="Password"
                            class="input"
                            type="password"
                            autocomplete="current-password"
                            placeholder="••••••••" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="forgot-row">
                        <a href="#" onclick="return false;">Forgot your password?</a>
                    </div>

                    <button class="submit-button" type="submit">Log in</button>
                </form>

                <div class="create-row">
                    Don't have an account?
                    <a href="/Registration?accountType=candidate&amp;returnUrl=@encodedReturnUrl">Create a profile</a>
                </div>
            </div>
        </section>
    </main>

    <footer class="auth-footer">
        <span>&copy; 2026 BothFind</span>
        <span aria-hidden="true">&bull;</span>
        <a href="https://bothfind.com/privacy">Privacy Policy</a>
        <span aria-hidden="true">&bull;</span>
        <a href="https://bothfind.com/terms">Terms of Service</a>
    </footer>
</body>
</html>
